---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import settings from '../data/settings.json';

const page = await getEntry('pages', 'pierwszy-trening');
const Content = page ? (await render(page)).Content : null;
const points = page?.data.points ?? [];
---

<Base
  title={page?.data.title ?? 'Pierwszy trening'}
  description={page?.data.heading ?? 'Pierwszy trening capoeiry w Koszalinie jest bezpłatny i do niczego nie zobowiązuje.'}
>
  <PageHeader
    eyebrow="Zanim przyjdziesz"
    title={page?.data.title ?? 'Pierwszy trening'}
    description={page?.data.heading}
  />

  <section class="section section--tight">
    <div class="container">
      {page?.data.pointsEyebrow && <p class="eyebrow">{page.data.pointsEyebrow}</p>}
      {page?.data.pointsHeading && <h2>{page.data.pointsHeading}</h2>}

      {points.length > 0 && (
        <div class="points">
          {points.map((punkt, i) => (
            <div class="point">
              <span class="point__number">{String(i + 1).padStart(2, '0')}</span>
              <h3>{punkt.title}</h3>
              <p>{punkt.description}</p>
            </div>
          ))}
        </div>
      )}

      {Content && <div class="prose prose--note"><Content /></div>}

      <div class="actions">
        <a href="/zajecia/" class="button">Zobacz plan treningów</a>
        {settings.phone && (
          <a href={`tel:+48${settings.phone.replace(/\s/g, '')}`} class="button button--outline">
            {settings.phone}
          </a>
        )}
        <a href="/faq/" class="button button--outline">Częste pytania</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2rem;
    margin-block: 2.5rem;
  }
  .point h3 { margin-bottom: 0.5rem; }
  .point p { color: var(--text-2); font-size: 0.9375rem; margin: 0; }
  .point__number {
    display: block;
    font-family: var(--font-display);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent-muted);
    margin-bottom: 0.75rem;
  }

  .prose--note { margin-bottom: 2.5rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
</style>
