---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const page = await getEntry('pages', 'regulamin');
const Content = page ? (await render(page)).Content : null;
---

<Base title="Regulamin" description="Regulamin uczestnictwa w treningach Akademii Capoeira Koszalin.">
  <PageHeader eyebrow="Formalności" title="Regulamin" description={page?.data.heading} />

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {Content ? <div class="proza proza--regulamin"><Content /></div> : <p class="pusto">Brak treści.</p>}
    </div>
  </section>
</Base>

<style>
  .proza--regulamin :global(h2) {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linia);
  }
  .proza--regulamin :global(h3) {
    font-size: 0.875rem;
    letter-spacing: 0.18em;
    color: var(--akcent);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .proza--regulamin { font-size: 1rem; }
  .pusto { color: var(--tekst-3); }
</style>
