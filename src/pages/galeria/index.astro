---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Baza from '../../layouts/Baza.astro';
import NaglowekStrony from '../../components/NaglowekStrony.astro';
import { obraz } from '../../lib/media';
import { dataPl, ileZdjec } from '../../lib/format';

const albumy = (await getCollection('galeria')).sort((a, b) => b.data.data.getTime() - a.data.data.getTime());
---

<Baza tytul="Galeria" opis="Zdjęcia z treningów, batizado i rod Akademii Capoeira Koszalin.">
  <NaglowekStrony nadtytul="Roda w obiektywie" tytul="Galeria" />

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {albumy.length === 0 ? (
        <p class="pusto">Albumy pojawią się tu po dodaniu zdjęć w panelu.</p>
      ) : (
        <div class="albumy">
          {albumy.map((album) => {
            const okladka = obraz(album.data.okladka ?? album.data.zdjecia[0]);
            return (
              <a class="album" href={`/galeria/${album.id}/`}>
                <div class="album__foto">
                  {okladka ? (
                    <Image src={okladka} alt="" widths={[500, 900]} sizes="(max-width: 700px) 100vw, 380px" loading="lazy" />
                  ) : (
                    <div class="album__zastepnik" aria-hidden="true"></div>
                  )}
                </div>
                <div class="album__opis">
                  <h2 class="album__tytul">{album.data.tytul}</h2>
                  <p class="album__meta">
                    {dataPl(album.data.data)} · <span set:html={ileZdjec(album.data.zdjecia.length).replace(" ", "&nbsp;")} />
                  </p>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Baza>

<style>
  .albumy { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
  .album { text-decoration: none; display: block; }
  .album__foto {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--linia);
    background: var(--tlo-3);
  }
  .album__foto :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(0.45);
    transition: transform 0.5s ease, filter 0.35s ease;
  }
  .album:hover .album__foto :global(img) { transform: scale(1.05); filter: grayscale(0); }
  .album__zastepnik {
    width: 100%; height: 100%;
    background: radial-gradient(70% 70% at 40% 30%, rgba(var(--akcent-rgb), 0.16), transparent 70%), var(--tlo-3);
  }
  .album__opis { padding-top: 1rem; }
  .album__tytul { font-size: 1.25rem; margin: 0 0 0.35rem; }
  .album__meta {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tekst-3);
    margin: 0;
  }
  .pusto { color: var(--tekst-3); }
</style>
