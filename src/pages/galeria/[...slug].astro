---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { resolveImage } from '../../lib/media';
import { formatDate, photoCount } from '../../lib/format';

export async function getStaticPaths() {
  const albums = await getCollection('gallery');
  return albums.map((album) => ({ params: { slug: album.id }, props: { album } }));
}

const { album } = Astro.props;
const images = album.data.images.map((s) => resolveImage(s)).filter((f) => f !== undefined);
---

<Base title={album.data.title} description={`Zdjęcia: ${album.data.title}`}>
  <header class="header">
    <div class="container">
      <a href="/galeria/" class="back">← Galeria</a>
      <p class="meta">{formatDate(album.data.date)} · <span set:html={photoCount(images.length).replace(" ", "&nbsp;")} /></p>
      <h1>{album.data.title}</h1>
    </div>
  </header>

  <section class="section section--tight">
    <div class="container">
      <div class="grid">
        {images.map((photo, i) => (
          <button class="tile" data-index={i} aria-label={`Powiększ zdjęcie ${i + 1}`}>
            <Image src={photo} alt="" widths={[400, 800]} sizes="(max-width: 700px) 50vw, 280px" loading="lazy" />
          </button>
        ))}
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox tabindex="-1">
    <button class="lightbox__close" data-close aria-label="Zamknij">×</button>
    <button class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Poprzednie">‹</button>
    <img class="lightbox__photo" data-photo alt="" />
    <button class="lightbox__nav lightbox__nav--next" data-next aria-label="Następne">›</button>
  </dialog>

  <script type="application/json" id="album-images" set:html={JSON.stringify(images.map((f) => f.src))} />
</Base>

<style>
  .header {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: 2rem;
    background: radial-gradient(120% 80% at 15% 0%, rgba(var(--accent-rgb), 0.13), transparent 60%), var(--bg);
  }
  .back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }
  .back:hover { color: var(--accent); }
  .meta {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  /* Ta sama zasada co w grafiku zajęć: linie na kaflach, nie na tle kontenera. */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .tile {
    padding: 0;
    border: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg-3);
    cursor: zoom-in;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .tile :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(0.4);
    transition: transform 0.4s ease, filter 0.3s ease;
  }
  .tile:hover :global(img) { transform: scale(1.06); filter: grayscale(0); }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  /* Zaznaczenie trafia na samo okno, nie na krzyżyk — inaczej po otwarciu
     przeglądarka rysuje wokół niego swoją niebieską obwódkę. */
  .lightbox:focus { outline: none; }
  .lightbox button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .lightbox::backdrop { background: rgba(6, 6, 7, 0.94); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox__photo { max-width: 92vw; max-height: 88vh; object-fit: contain; }

  .lightbox__close,
  .lightbox__nav {
    position: fixed;
    background: none;
    border: 0;
    color: var(--text-2);
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s ease;
  }
  .lightbox__close:hover,
  .lightbox__nav:hover { color: var(--accent); }
  .lightbox__close { top: 1rem; right: 1.5rem; font-size: 2.75rem; }
  .lightbox__nav { top: 50%; transform: translateY(-50%); font-size: 4rem; padding: 0 1.25rem; }
  .lightbox__nav--prev { left: 0; }
  .lightbox__nav--next { right: 0; }
</style>

<script>
  const source = document.getElementById('album-images');
  const images: string[] = source ? JSON.parse(source.textContent || '[]') : [];
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const photo = document.querySelector<HTMLImageElement>('[data-photo]');
  let current = 0;

  const show = (i: number) => {
    if (!photo || images.length === 0) return;
    current = (i + images.length) % images.length;
    photo.src = images[current];
  };

  document.querySelectorAll<HTMLButtonElement>('.tile').forEach((tile) => {
    tile.addEventListener('click', () => {
      show(Number(tile.dataset.index));
      lightbox?.showModal();
      // Bez tego przeglądarka zaznacza pierwszy przycisk i rysuje wokół niego
      // swoją obwódkę. Atrybut autofocus na <dialog> nie jest respektowany wszędzie.
      lightbox?.focus();
    });
  });

  document.querySelector('[data-close]')?.addEventListener('click', () => lightbox?.close());
  document.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
  document.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.open) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
