---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';

const questions = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const withAnswers = await Promise.all(
  questions.map(async (p) => ({ entry: p, Answer: (await render(p)).Content }))
);
---

<Base
  title="Częste pytania"
  description="Co zabrać na trening, czy trzeba być sprawnym, od jakiego wieku, jak się zapisać — odpowiedzi na najczęstsze pytania."
>
  <PageHeader
    eyebrow="Zanim przyjdziesz"
    title="Częste pytania"
    description="Jeśli czegoś tu brakuje, zadzwoń — chętnie odpowiemy."
  />

  <section class="section section--tight">
    <div class="container">
      <div class="list">
        {withAnswers.map(({ entry, Answer }, i) => (
          <details class="question">
            <summary class="question__header">
              <span class="question__number">{String(i + 1).padStart(2, '0')}</span>
              <span class="question__text">{entry.data.question}</span>
              <span class="question__mark" aria-hidden="true"></span>
            </summary>
            <div class="question__answer prose"><Answer /></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .list { border-top: 1px solid var(--line); }
  .question { border-bottom: 1px solid var(--line); }

  .question__header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s ease;
  }
  .question__header::-webkit-details-marker { display: none; }
  .question__header:hover { color: var(--accent); }

  .question__number {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    color: var(--accent-muted);
    flex: none;
  }
  .question__text {
    flex: 1;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .question__mark {
    flex: none;
    position: relative;
    width: 14px;
    height: 14px;
  }
  .question__mark::before,
  .question__mark::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: var(--accent);
    transition: transform 0.25s ease;
  }
  .question__mark::after { transform: rotate(90deg); }
  .question[open] .question__mark::after { transform: rotate(0deg); }

  .question__answer { padding: 0 0 1.6rem calc(0.8125rem + 1.25rem); max-width: 70ch; }
  @media (max-width: 600px) { .question__answer { padding-left: 0; } }
</style>
