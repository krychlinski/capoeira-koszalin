---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import settings from '../data/settings.json';

const all = (await getCollection('pricing')).sort((a, b) => a.data.order - b.data.order);
const monthly = all.filter((p) => p.data.category === 'monthly');
const extra = all.filter((p) => p.data.category === 'extra');
const payments = settings.payments ?? [];
---

<Base title="Cennik" description="Karnety i opłaty w Akademii Capoeira Koszalin. Pierwszy trening jest bezpłatny.">
  <PageHeader
    eyebrow="Opłaty"
    title="Cennik"
    description="Pierwszy trening zapoznawczy jest bezpłatny i do niczego nie zobowiązuje."
  />

  <section class="section section--tight">
    <div class="container">
      <h2 class="group-title">Karnety miesięczne</h2>
      <div class="items">
        {monthly.map((p) => (
          <div class="item">
            <div class="item__description">
              <h3 class="item__name">{p.data.name}</h3>
              {p.data.description && <p class="item__detail">{p.data.description}</p>}
            </div>
            <p class="item__price">{p.data.price}</p>
          </div>
        ))}
      </div>

      <p class="note">
        Wszystkie opłaty miesięczne są płatne z góry, do 10. dnia miesiąca.
      </p>

      <h2 class="group-title group-title--second">Opłaty dodatkowe</h2>
      <div class="items">
        {extra.map((p) => (
          <div class="item">
            <div class="item__description">
              <h3 class="item__name">{p.data.name}</h3>
              {p.data.description && <p class="item__detail">{p.data.description}</p>}
            </div>
            <p class="item__price">{p.data.price}</p>
          </div>
        ))}
      </div>

      {payments.length > 0 && (
        <>
          <h2 class="group-title group-title--second">Jak zapłacić</h2>
          <div class="accounts">
            {payments.map((p) => (
              <div class="account">
                <p class="account__label">{p.label}</p>
                <p class="account__recipient">{p.recipient}</p>
                {p.account && (
                  <p class="account__row">
                    <span class="account__key">Numer konta{p.bank && ` (${p.bank})`}</span>
                    <span class="account__number">{p.account}</span>
                  </p>
                )}
                {p.blik && (
                  <p class="account__row">
                    <span class="account__key">BLIK</span>
                    <span class="account__number">{p.blik}</span>
                  </p>
                )}
                {p.note && <p class="account__note">{p.note}</p>}
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <section class="section section--tight promo">
    <div class="container promo__inner">
      <div>
        <p class="eyebrow">Zanim zapłacisz</p>
        <h2>Przyjdź najpierw<br /><span>na darmowy trening</span></h2>
      </div>
      <div class="promo__actions">
        <a href="/zajecia/" class="button">Sprawdź grafik</a>
        {settings.phone && (
          <a href={`tel:+48${settings.phone.replace(/\s/g, '')}`} class="button button--outline">
            {settings.phone}
          </a>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  .group-title { font-size: clamp(1.25rem, 2.5vw, 1.75rem); margin-bottom: 1.75rem; color: var(--text-2); }
  .group-title--second { margin-top: 4rem; }

  .items { border-top: 1px solid var(--line); }
  .item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line);
  }
  .item__description { flex: 1; }
  .item__name { font-size: 1.125rem; margin: 0 0 0.25rem; }
  .item__detail { color: var(--text-3); font-size: 0.9375rem; margin: 0; }
  .item__price {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .accounts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .account {
    padding: 1.5rem;
    background: var(--bg-2);
    border-left: 2px solid var(--accent);
  }
  .account__label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-3);
    margin: 0 0 0.5rem;
  }
  .account__recipient { margin: 0 0 1.25rem; font-size: 1.0625rem; color: var(--text); }
  .account__row { margin: 0 0 0.75rem; }
  .account__key { display: block; font-size: 0.8125rem; color: var(--text-3); margin-bottom: 0.15rem; }
  .account__number {
    display: block;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    letter-spacing: 0.04em;
    color: var(--text);
    /* Numer konta ma się dać zaznaczyć i skopiować w całości, także na telefonie. */
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .account__note { margin: 1rem 0 0; font-size: 0.9375rem; color: var(--text-2); }

  .note {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-left: 2px solid var(--accent);
    background: var(--bg-2);
    color: var(--text-2);
    font-size: 0.9375rem;
  }

  .promo__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .promo__inner h2 { margin: 0; }
  .promo__inner h2 span { color: var(--accent); }
  .promo__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }
</style>
