---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { allNews } from '../../lib/news';
import { formatDate } from '../../lib/format';
import settings from '../../data/settings.json';

const entries = await allNews();
---

<Base title="Aktualności" description="Co się dzieje w Akademii Capoeira Koszalin.">
  <PageHeader eyebrow="Z życia grupy" title="Aktualności" />

  <section class="section section--tight">
    <div class="container">
      {entries.length === 0 ? (
        <p class="empty">
          Nie ma jeszcze żadnych wpisów.
          {settings.facebook && (
            <> Zajrzyj na <a href={settings.facebook} target="_blank" rel="noopener noreferrer">nasz Facebook</a>.</>
          )}
        </p>
      ) : (
        <div class="card-grid">
          {entries.map((x) => (
            <PostCard
              href={x.href}
              title={x.title}
              meta={x.facebookUrl ? `${formatDate(x.date)} · Facebook` : formatDate(x.date)}
              excerpt={x.excerpt}
              points={x.points}
              image={x.image}
              imageUrl={x.images[0]}
              imageCount={x.images.length}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .empty { color: var(--text-3); }
  .empty a { color: var(--accent); }
</style>
