---
import Baza from '../../layouts/Baza.astro';
import NaglowekStrony from '../../components/NaglowekStrony.astro';
import KartaWpisu from '../../components/KartaWpisu.astro';
import { wszystkieAktualnosci } from '../../lib/aktualnosci';
import { dataPl } from '../../lib/format';
import ustawienia from '../../data/ustawienia.json';

const wpisy = await wszystkieAktualnosci();
---

<Baza tytul="Aktualności" opis="Co się dzieje w Akademii Capoeira Koszalin.">
  <NaglowekStrony nadtytul="Z życia grupy" tytul="Aktualności" />

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {wpisy.length === 0 ? (
        <p class="pusto">
          Nie ma jeszcze żadnych wpisów.
          {ustawienia.facebook && (
            <> Zajrzyj na <a href={ustawienia.facebook} target="_blank" rel="noopener noreferrer">nasz Facebook</a>.</>
          )}
        </p>
      ) : (
        <div class="siatka-kart">
          {wpisy.map((x) => (
            <KartaWpisu
              href={x.href}
              tytul={x.tytul}
              meta={dataPl(x.data)} · Facebook` : dataPl(w.data)}
              zajawka={x.zajawka}
              zdjecie={x.zdjecie}
              zdjecieUrl={x.zdjecia[0]}
              liczbaZdjec={x.zdjecia.length}
            />
          ))}
        </div>
      )}
    </div>
  </section>
</Baza>

<style>
  .siatka-kart { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .pusto { color: var(--tekst-3); }
  .pusto a { color: var(--akcent); }
</style>
