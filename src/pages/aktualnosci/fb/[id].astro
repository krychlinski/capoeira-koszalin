---
import { existsSync } from 'node:fs';
import Base from '../../../layouts/Base.astro';
import { fetchPosts } from '../../../lib/facebook';
import { videoFor } from '../../../lib/news';
import { toBlocks, stripMarkers } from '../../../lib/blocks';
import { formatDate, isoDate } from '../../../lib/format';

export async function getStaticPaths() {
  const posty = await fetchPosts();
  return posty.map((p) => ({ params: { id: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const images = Array.from({ length: post.imageCount }, (_, i) => `/media/fb/${post.id}-${i}.jpg`).filter(
  (path) => existsSync(`public${path}`)
);
// Pierwsze zdjęcie otwiera wpis nad tekstem. Siatka pod tekstem pokazuje wszystkie
// zdjęcia, pierwsze też — ale tylko gdy jest ich więcej niż jedno.
const [lead] = images;
const many = images.length > 1;
const video = videoFor(post.id, post.hasVideo);
const lines = post.body.split('\n').map((l) => l.trim()).filter(Boolean);
const title = stripMarkers(lines[0] ?? '');
const blocks = toBlocks(lines.slice(1).join('\n'));
---

<Base title={title.slice(0, 60)} description={stripMarkers(lines.slice(1).join('\n')).slice(0, 160) || title}>
  <article>
    <header class="header">
      <div class="container">
        <a href="/aktualnosci/" class="back">← Aktualności</a>
        <time class="date" datetime={isoDate(post.date)}>{formatDate(post.date)}</time>
        <h1>{title}</h1>
      </div>
    </header>

    {video?.src && (
      <div class="container">
        {/* preload="metadata": sam film nie schodzi, dopóki ktoś nie kliknie, ale
            przeglądarka zna długość i potrafi narysować pasek postępu. */}
        <div class="film">
          <video src={video.src} poster={video.poster} controls playsinline preload="metadata">
            <a href={video.src}>Pobierz film</a>
          </video>
        </div>
      </div>
    )}

    {/* Film ponad limit integracja pomija — zostaje plansza i odesłanie do oryginału,
        zamiast pustego miejsca po nagraniu, o którym wpis wspomina. */}
    {video && !video.src && video.poster && (
      <div class="container">
        <a class="film-link" href={post.permalink} target="_blank" rel="noopener noreferrer">
          <img src={video.poster} alt="" decoding="async" />
          <span class="film-link__label">Obejrzyj film na Facebooku ↗</span>
        </a>
      </div>
    )}

    {lead && (
      <div class="container">
        <button class="lead" data-index="0" aria-label={many ? `Powiększ zdjęcie 1 z ${images.length}` : 'Powiększ zdjęcie'}>
          <img src={lead} alt="" decoding="async" fetchpriority="high" />
        </button>
      </div>
    )}

    <div class="container content">
      <div class="prose">
        {blocks.map((b) =>
          b.type === 'paragraph' ? (
            <p>{b.text}</p>
          ) : b.ordered ? (
            <ol>
              {b.items.map((item) => (
                <li>
                  {item.text}
                  {item.children.length > 0 && <ul>{item.children.map((x) => <li>{x}</li>)}</ul>}
                </li>
              ))}
            </ol>
          ) : (
            <ul>
              {b.items.map((item) => (
                <li>
                  {item.text}
                  {item.children.length > 0 && <ul>{item.children.map((x) => <li>{x}</li>)}</ul>}
                </li>
              ))}
            </ul>
          )
        )}
      </div>

      {post.link && (
        <a class="link" href={post.link.url} target="_blank" rel="noopener noreferrer">
          <span class="link__domain">{post.link.domain} ↗</span>
          {post.link.title && <span class="link__title">{post.link.title}</span>}
          {post.link.description && <span class="link__description">{post.link.description}</span>}
        </a>
      )}

      {many && (
        <div class="gallery">
          {images.map((src, i) => (
            <button class="tile" data-index={i} aria-label={`Powiększ zdjęcie ${i + 1} z ${images.length}`}>
              <img src={src} alt="" loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      )}

      <p class="source">
        Wpis pochodzi z naszego Facebooka.
        <a href={post.permalink} target="_blank" rel="noopener noreferrer">Zobacz oryginał</a>
      </p>
    </div>
  </article>

  {images.length > 0 && (
    <dialog class="lightbox" data-lightbox tabindex="-1">
      <button class="lightbox__close" data-close aria-label="Zamknij">×</button>
      {many && <button class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Poprzednie">‹</button>}
      <img class="lightbox__photo" data-photo alt="" />
      {many && <span class="lightbox__counter" data-counter></span>}
      {many && <button class="lightbox__nav lightbox__nav--next" data-next aria-label="Następne">›</button>}
    </dialog>
    <script type="application/json" id="post-images" set:html={JSON.stringify(images)} />
  )}
</Base>

<style>
  .header {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: 2.5rem;
    background: radial-gradient(120% 80% at 15% 0%, rgba(var(--accent-rgb), 0.13), transparent 60%), var(--bg);
  }
  .back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }
  .back:hover { color: var(--accent); }
  .date {
    display: block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .header h1 { font-size: clamp(1.75rem, 4.5vw, 3.25rem); max-width: 24ch; }

  .content { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 10vw, 7rem); }

  /* Zdjęcie pokazujemy w całości, bez przycinania — na Facebooku to często plakat
     z tekstem, a pionowy kadr ucięty do pasa gubiłby datę i godzinę. */
  .lead {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 0;
    border: 1px solid var(--line);
    background: var(--bg-3);
    cursor: zoom-in;
    overflow: hidden;
  }
  .lead img {
    width: auto;
    max-width: 100%;
    max-height: min(80vh, 44rem);
    object-fit: contain;
  }

  /* Rolki z Facebooka są pionowe. Rozciągnięte na całą szerokość zostawiałyby
     szerokie czarne pasy po bokach, więc trzymamy naturalną proporcję i centrujemy
     — tak samo jak zdjęcie wyżej. */
  .film {
    display: flex;
    justify-content: center;
    background: var(--bg-3);
    border: 1px solid var(--line);
  }
  .film video {
    width: auto;
    max-width: 100%;
    max-height: min(80vh, 44rem);
  }

  .film-link {
    position: relative;
    display: flex;
    justify-content: center;
    border: 1px solid var(--line);
    background: var(--bg-3);
    overflow: hidden;
  }
  .film-link img {
    width: auto;
    max-width: 100%;
    max-height: min(80vh, 44rem);
    object-fit: contain;
    filter: brightness(0.6);
    transition: filter 0.3s ease;
  }
  .film-link:hover img { filter: brightness(0.75); }
  .film-link__label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.85rem 1.6rem;
    background: rgba(6, 6, 7, 0.75);
    border: 1px solid var(--accent);
    font-family: var(--font-display);
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text);
    text-align: center;
  }
  .film-link:hover .film-link__label { color: var(--accent); }

  .link {
    display: grid;
    gap: 0.35rem;
    max-width: 44rem;
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    text-decoration: none;
    transition: border-color 0.25s ease;
  }
  .link:hover { border-color: var(--accent); }
  .link__domain {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .link:hover .link__domain { color: var(--accent); }
  .link__title { font-family: var(--font-display); font-size: 1.2rem; color: var(--text); }
  .link__description { color: var(--text-2); font-size: 0.9375rem; }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: clamp(0.5rem, 1.5vw, 0.9rem);
    margin-top: 2.5rem;
  }
  .tile {
    padding: 0;
    border: 1px solid var(--line);
    background: var(--bg-3);
    cursor: zoom-in;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .tile img {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(0.35);
    transition: transform 0.4s ease, filter 0.3s ease;
  }
  .tile:hover img { transform: scale(1.06); filter: grayscale(0); }

  .source {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--text-3);
    font-size: 0.9375rem;
  }
  .source a { color: var(--accent); margin-left: 0.4rem; }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
  }
  /* Zaznaczenie trafia na samo okno, nie na krzyżyk — inaczej po otwarciu
     przeglądarka rysuje wokół niego swoją niebieską obwódkę. */
  .lightbox:focus { outline: none; }
  .lightbox button:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .lightbox::backdrop { background: rgba(6, 6, 7, 0.94); }
  .lightbox[open] { display: flex; align-items: center; justify-content: center; }
  .lightbox__photo { max-width: 92vw; max-height: 86vh; object-fit: contain; }
  .lightbox__close, .lightbox__nav {
    position: fixed; background: none; border: 0; color: var(--text-2);
    cursor: pointer; line-height: 1; transition: color 0.2s ease;
  }
  .lightbox__close:hover, .lightbox__nav:hover { color: var(--accent); }
  .lightbox__close { top: 1rem; right: 1.5rem; font-size: 2.75rem; }
  .lightbox__nav { top: 50%; transform: translateY(-50%); font-size: 4rem; padding: 0 1.25rem; }
  .lightbox__nav--prev { left: 0; }
  .lightbox__nav--next { right: 0; }
  .lightbox__counter {
    position: fixed; bottom: 1.5rem; left: 50%; transform: translateX(-50%);
    font-family: var(--font-display); font-size: 0.8125rem; letter-spacing: 0.2em;
    color: var(--text-2);
  }
</style>

<script>
  const source = document.getElementById('post-images');
  const images: string[] = source ? JSON.parse(source.textContent || '[]') : [];
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const photo = document.querySelector<HTMLImageElement>('[data-photo]');
  const counter = document.querySelector<HTMLElement>('[data-counter]');
  let current = 0;

  const show = (i: number) => {
    if (!photo || !images.length) return;
    current = (i + images.length) % images.length;
    photo.src = images[current];
    if (counter) counter.textContent = `${current + 1} / ${images.length}`;
  };

  document.querySelectorAll<HTMLButtonElement>('.lead, .tile').forEach((tile) => {
    tile.addEventListener('click', () => {
      show(Number(tile.dataset.index));
      lightbox?.showModal();
      // Bez tego przeglądarka zaznacza pierwszy przycisk i rysuje wokół niego
      // swoją obwódkę. Atrybut autofocus na <dialog> nie jest respektowany wszędzie.
      lightbox?.focus();
    });
  });

  document.querySelector('[data-close]')?.addEventListener('click', () => lightbox?.close());
  document.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
  document.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) lightbox.close();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.open) return;
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
