---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Baza from '../../layouts/Baza.astro';
import NaglowekStrony from '../../components/NaglowekStrony.astro';
import { obraz } from '../../lib/media';

const lista = (await getCollection('instruktorzy')).sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const zTrescia = await Promise.all(
  lista.map(async (i) => ({ wpis: i, foto: obraz(i.data.zdjecie), render: await render(i) }))
);
---

<Baza tytul="Instruktorzy" opis="Kto prowadzi treningi capoeiry w Koszalinie.">
  <NaglowekStrony nadtytul="Ludzie" tytul="Instruktorzy" />

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {zTrescia.length === 0 ? (
        <p class="pusto">Sylwetki instruktorów pojawią się tu po dodaniu ich w panelu.</p>
      ) : (
        <div class="lista">
          {zTrescia.map(({ wpis, foto, render: r }) => {
            const Tresc = r.Content;
            return (
              <article class="osoba">
                <div class="osoba__foto">
                  {foto ? (
                    <Image src={foto} alt={wpis.data.imie} widths={[400, 800]} sizes="(max-width: 800px) 100vw, 340px" loading="lazy" />
                  ) : (
                    <div class="osoba__zastepnik" aria-hidden="true"></div>
                  )}
                </div>
                <div class="osoba__tresc">
                  {wpis.data.apelido && <p class="osoba__apelido">{wpis.data.apelido}</p>}
                  <h2 class="osoba__imie">{wpis.data.imie}</h2>
                  {wpis.data.stopien && <p class="osoba__stopien">{wpis.data.stopien}</p>}
                  <div class="proza"><Tresc /></div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Baza>

<style>
  .lista { display: grid; gap: clamp(3rem, 7vw, 5rem); }
  .osoba {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 800px) { .osoba { grid-template-columns: 1fr; } }

  .osoba__foto { aspect-ratio: 3 / 4; overflow: hidden; border: 1px solid var(--linia); }
  .osoba__foto :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.5) contrast(1.05); }
  .osoba__zastepnik {
    width: 100%; height: 100%;
    background: radial-gradient(70% 70% at 40% 30%, rgba(224, 138, 43, 0.16), transparent 70%), var(--tlo-3);
  }

  .osoba__apelido {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--akcent);
    margin: 0 0 0.5rem;
  }
  .osoba__imie { font-size: clamp(1.75rem, 4vw, 2.75rem); margin-bottom: 0.35rem; }
  .osoba__stopien { color: var(--tekst-3); font-size: 0.9375rem; margin-bottom: 1.5rem; }
  .pusto { color: var(--tekst-3); }
</style>
