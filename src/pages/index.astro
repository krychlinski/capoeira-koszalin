---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Schedule from '../components/Schedule.astro';
import Notice from '../components/Notice.astro';
import PostCard from '../components/PostCard.astro';
import settings from '../data/settings.json';
import { resolveImage } from '../lib/media';
import { formatDate, formatDateRange } from '../lib/format';
import { allNews } from '../lib/news';

const classes = (await getCollection('classes')).sort((a, b) => a.data.order - b.data.order);

const now = new Date();
const upcoming = (await getCollection('events'))
  .filter((w) => (w.data.endDate ?? w.data.startDate) >= now)
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());
const nextEvent = upcoming[0];
const eventPhoto = resolveImage(nextEvent?.data.image);

const aktualnosci = (await allNews()).slice(0, 3);

const albums = (await getCollection('gallery')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const preview = albums.flatMap((a) => a.data.images).slice(0, 6);
---

<Base>
  <Hero />

  <section class="sekcja intro" id="czym-jest-capoeira">
    <div class="kontener intro__siatka">
      <div>
        <p class="nadtytul">Czym jest capoeira</p>
        <h2>Brazylijska sztuka,<br />która nie pyta o wiek</h2>
      </div>
      <div class="intro__tekst">
        <p>
          Capoeira to jednocześnie sztuka walki, taniec, gra i muzyka. Powstała w Brazylii wśród
          zniewolonych mieszkańców Afryki, którzy ukryli trening walki pod postacią tańca. Dziś to
          przede wszystkim sposób na ruch, rytm i ludzi.
        </p>
        <p>
          Na treningu uczysz się akrobatyki, kopnięć i uników, ale też gry na berimbau i śpiewu po
          portugalsku. Nie musisz być sprawny, młody ani muzykalny — wystarczy, że przyjdziesz.
        </p>
        <a href="/o-nas/" class="przycisk przycisk--obrys">Poznaj naszą grupę</a>
      </div>
    </div>
  </section>

  <section class="cta">
    <div class="kontener cta__wnetrze">
      <h2>Pierwszy trening<br /><span>nic nie kosztuje</span></h2>
      <div class="cta__akcje">
        <a href="/kontakt/" class="przycisk">Zapytaj o zajęcia</a>
        {settings.phone && (
          <a href={`tel:+48${settings.phone.replace(/\s/g, '')}`} class="przycisk przycisk--obrys">
            {settings.phone}
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="sekcja sekcja--ciasna zajecia-blok" id="kiedy-trenujemy">
    <div class="kontener">
      <p class="nadtytul">Grafik</p>
      <h2>Kiedy trenujemy</h2>
      <Notice />
      <Schedule classes={classes} />
      <div class="zajecia-blok__stopka">
        <p>Przyjdź w wygodnym ubraniu — resztę pokażemy na miejscu.</p>
        <div class="zajecia-blok__akcje">
          <a href="/cennik/" class="przycisk przycisk--obrys">Cennik</a>
        </div>
      </div>
    </div>
  </section>

  {nextEvent && (
    <section class="sekcja wydarzenie">
      <div class="kontener wydarzenie__siatka">
        <div class="wydarzenie__foto">
          {eventPhoto ? (
            <Image src={eventPhoto} alt="" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 520px" loading="lazy" />
          ) : (
            <div class="wydarzenie__zastepnik" aria-hidden="true"></div>
          )}
        </div>
        <div class="wydarzenie__tresc">
          <p class="nadtytul">Najbliższe wydarzenie</p>
          <h2>{nextEvent.data.title}</h2>
          <p class="wydarzenie__data">
            {formatDateRange(nextEvent.data.startDate, nextEvent.data.endDate)}
            {nextEvent.data.venue && <span> · {nextEvent.data.venue}</span>}
          </p>
          {nextEvent.data.excerpt && <p class="wydarzenie__zajawka">{nextEvent.data.excerpt}</p>}
          <a href={`/wydarzenia/${nextEvent.id}/`} class="przycisk">Szczegóły</a>
        </div>
      </div>
    </section>
  )}

  {aktualnosci.length > 0 && (
    <section class="sekcja sekcja--ciasna">
      <div class="kontener">
        <div class="naglowek-listy">
          <div>
            <p class="nadtytul">Z życia grupy</p>
            <h2>Aktualności</h2>
          </div>
          <a href="/aktualnosci/" class="przycisk przycisk--obrys">Wszystkie wpisy</a>
        </div>
        <div class="siatka-kart">
          {aktualnosci.map((x) => (
            <PostCard
              href={x.href}
              title={x.title}
              meta={x.facebookUrl ? `${formatDate(x.date)} · Facebook` : formatDate(x.date)}
              excerpt={x.excerpt}
              points={x.points}
              image={x.image}
              imageUrl={x.images[0]}
              imageCount={x.images.length}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {preview.length > 0 && (
    <section class="sekcja sekcja--ciasna">
      <div class="kontener">
        <div class="naglowek-listy">
          <div>
            <p class="nadtytul">Roda w obiektywie</p>
            <h2>Galeria</h2>
          </div>
          <a href="/galeria/" class="przycisk przycisk--obrys">Zobacz albums</a>
        </div>
      </div>
      <div class="pasek">
        {preview.map((path) => {
          const photo = resolveImage(path);
          return photo ? (
            <Image src={photo} alt="" widths={[400, 800]} sizes="320px" loading="lazy" class="pasek__foto" />
          ) : null;
        })}
      </div>
    </section>
  )}

</Base>

<style>
  /* Pasek nawigacji jest przyklejony, więc cel skoku musi mieć zapas u góry. */
  .intro { scroll-margin-top: 5rem; }

  .intro__siatka {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  @media (max-width: 860px) { .intro__siatka { grid-template-columns: 1fr; } }
  .intro__tekst { color: var(--tekst-2); font-size: 1.0625rem; }
  .intro__tekst .przycisk { margin-top: 0.75rem; }

  /* Sekcje na przemian ciemne i jasne. Numeruje je przeglądarka, a nie ja, więc
     ukrycie wydarzenia albo galerii nie rozbija rytmu — kolejne przejmują numery.
     Hasło ma własne tło ze zdjęciem i nie bierze w tym udziału. */
  section:not(.hero):nth-of-type(odd) { background-color: var(--tlo-2); }
  section:not(.hero):nth-of-type(even) { background-color: var(--tlo); }

  .zajecia-blok {
    border-block: 1px solid var(--linia);
    scroll-margin-top: 5rem;
  }
  .zajecia-blok__stopka {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }
  .zajecia-blok__stopka p { margin: 0; color: var(--tekst-2); max-width: 46ch; }
  .zajecia-blok__akcje { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .wydarzenie__siatka {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  @media (max-width: 900px) { .wydarzenie__siatka { grid-template-columns: 1fr; } }
  .wydarzenie__foto { aspect-ratio: 4 / 3; overflow: hidden; border: 1px solid var(--linia); }
  .wydarzenie__foto :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .wydarzenie__zastepnik {
    width: 100%; height: 100%;
    background: radial-gradient(70% 70% at 40% 30%, rgba(var(--akcent-rgb), 0.18), transparent 70%), var(--tlo-3);
  }
  .wydarzenie__data {
    font-family: var(--font-display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.875rem;
    color: var(--akcent);
  }
  .wydarzenie__zajawka { color: var(--tekst-2); max-width: 50ch; }

  .naglowek-listy {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  .naglowek-listy h2 { margin: 0; }

  .siatka-kart {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .pasek {
    display: flex;
    gap: 1px;
    overflow-x: auto;
    padding-top: 2rem;
    scrollbar-width: none;
  }
  .pasek::-webkit-scrollbar { display: none; }
  .pasek :global(.pasek__foto) {
    flex: none;
    width: 320px;
    height: 240px;
    object-fit: cover;
    filter: grayscale(0.4);
    transition: filter 0.3s ease;
  }
  .pasek :global(.pasek__foto:hover) { filter: grayscale(0); }

  .cta {
    padding-block: clamp(4rem, 10vw, 7rem);
    background-image: radial-gradient(80% 120% at 80% 20%, rgba(var(--akcent-rgb), 0.16), transparent 65%);
    border-block: 1px solid var(--linia);
  }
  .cta__wnetrze {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta h2 { margin: 0; }
  .cta h2 span { color: var(--akcent); }
  .cta__akcje { display: flex; flex-wrap: wrap; gap: 0.9rem; }
</style>
