---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import settings from '../data/settings.json';

const page = await getEntry('pages', 'kontakt');
const Content = page ? (await render(page)).Content : null;

const telHref = settings.phone ? `tel:+48${settings.phone.replace(/\s/g, '')}` : null;
const social = [
  { href: settings.facebook, text: 'Facebook' },
  { href: settings.instagram, text: 'Instagram' },
  { href: settings.youtube, text: 'YouTube' },
].filter((s) => s.href);
---

<Base title="Kontakt" description="Zadzwoń albo napisz — odpowiemy i powiemy, kiedy przyjść na pierwszy trening.">
  <PageHeader
    eyebrow="Odezwij się"
    title="Kontakt"
    description="Najszybciej złapiesz nas telefonicznie. Możesz też po prostu przyjść na trening — nie trzeba się zapowiadać."
  />

  <section class="sekcja sekcja--ciasna">
    <div class="kontener siatka">
      <div class="dane">
        {telHref && (
          <div class="pozycja">
            <p class="pozycja__etykieta">Telefon</p>
            <a href={telHref} class="pozycja__wartosc pozycja__wartosc--duza">{settings.phone}</a>
          </div>
        )}

        {settings.email && (
          <div class="pozycja">
            <p class="pozycja__etykieta">E-mail</p>
            <a href={`mailto:${settings.email}`} class="pozycja__wartosc">{settings.email}</a>
          </div>
        )}

        {settings.address && (
          <div class="pozycja">
            <p class="pozycja__etykieta">Gdzie trenujemy</p>
            <p class="pozycja__wartosc">{settings.address}</p>
          </div>
        )}

        {social.length > 0 && (
          <div class="pozycja">
            <p class="pozycja__etykieta">Social media</p>
            <div class="social">
              {social.map((s) => (
                <a href={s.href} class="pozycja__wartosc" target="_blank" rel="noopener noreferrer">{s.text}</a>
              ))}
            </div>
          </div>
        )}

        <a href="/zajecia/" class="przycisk">Zobacz grafik zajęć</a>
      </div>

      <div class="tresc">
        {Content && <div class="proza"><Content /></div>}
      </div>
    </div>
  </section>
</Base>

<style>
  .siatka {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }
  @media (max-width: 800px) { .siatka { grid-template-columns: 1fr; } }

  .pozycja { padding-bottom: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--linia); }
  .pozycja__etykieta {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--tekst-3);
    margin: 0 0 0.5rem;
  }
  .pozycja__wartosc {
    font-size: 1.125rem;
    color: var(--tekst);
    text-decoration: none;
    margin: 0;
    display: block;
  }
  a.pozycja__wartosc:hover { color: var(--akcent); }
  .pozycja__wartosc--duza {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: 0.02em;
  }
  .social { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .social .pozycja__wartosc { display: inline-block; }
</style>
