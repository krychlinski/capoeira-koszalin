---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import settings from '../data/settings.json';

const page = await getEntry('pages', 'kontakt');
const Content = page ? (await render(page)).Content : null;

const telHref = settings.phone ? `tel:+48${settings.phone.replace(/\s/g, '')}` : null;
const social = [
  { href: settings.facebook, text: 'Facebook' },
  { href: settings.instagram, text: 'Instagram' },
  { href: settings.youtube, text: 'YouTube' },
].filter((s) => s.href);
---

<Base title="Kontakt" description="Zadzwoń albo napisz — odpowiemy i powiemy, kiedy przyjść na pierwszy trening.">
  <PageHeader
    eyebrow="Odezwij się"
    title="Kontakt"
    description="Najszybciej złapiesz nas telefonicznie. Możesz też po prostu przyjść na trening — nie trzeba się zapowiadać."
  />

  <section class="section section--tight">
    <div class="container grid">
      <div class="contact-details">
        {telHref && (
          <div class="item">
            <p class="item__label">Telefon</p>
            <a href={telHref} class="item__value item__value--large">{settings.phone}</a>
          </div>
        )}

        {settings.email && (
          <div class="item">
            <p class="item__label">E-mail</p>
            <a href={`mailto:${settings.email}`} class="item__value">{settings.email}</a>
          </div>
        )}

        {settings.address && (
          <div class="item">
            <p class="item__label">Gdzie trenujemy</p>
            <p class="item__value">{settings.address}</p>
          </div>
        )}

        {social.length > 0 && (
          <div class="item">
            <p class="item__label">Social media</p>
            <div class="social">
              {social.map((s) => (
                <a href={s.href} class="item__value" target="_blank" rel="noopener noreferrer">{s.text}</a>
              ))}
            </div>
          </div>
        )}

        <a href="/zajecia/" class="button">Zobacz grafik zajęć</a>
      </div>

      <div class="content">
        {Content && <div class="prose"><Content /></div>}
      </div>
    </div>
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: start;
  }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }

  .item { padding-bottom: 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid var(--line); }
  .item__label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-3);
    margin: 0 0 0.5rem;
  }
  .item__value {
    font-size: 1.125rem;
    color: var(--text);
    text-decoration: none;
    margin: 0;
    display: block;
  }
  a.item__value:hover { color: var(--accent); }
  .item__value--large {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: 0.02em;
  }
  .social { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .social .item__value { display: inline-block; }

</style>
