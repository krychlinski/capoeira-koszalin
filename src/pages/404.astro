---
import Base from '../layouts/Base.astro';
---

<Base title="Nie ma takiej strony">
  <section class="section error">
    <div class="container">
      <p class="eyebrow">Błąd 404</p>
      <h1>Ta strona<br />uciekła z rody</h1>
      <p class="error__description">Nie znaleźliśmy tego, czego szukasz. Wróć na stronę główną albo sprawdź grafik zajęć.</p>
      <div class="error__actions">
        <a href="/" class="button">Strona główna</a>
        <a href="/zajecia/" class="button button--outline">Grafik zajęć</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .error { padding-top: clamp(9rem, 18vw, 14rem); min-height: 70svh; }
  .error__description { color: var(--text-2); max-width: 46ch; }
  .error__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 2rem; }
</style>
