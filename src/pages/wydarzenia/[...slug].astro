---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { resolveImage } from '../../lib/media';
import { formatDateRange, isoDate } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('events');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const photo = resolveImage(entry.data.image);
const past = (entry.data.endDate ?? entry.data.startDate) < new Date();
---

<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="wpis">
    <header class="wpis__naglowek">
      <div class="kontener">
        <a href="/wydarzenia/" class="wpis__powrot">← Wydarzenia</a>
        <p class="wpis__data">
          <time datetime={isoDate(entry.data.startDate)}>{formatDateRange(entry.data.startDate, entry.data.endDate)}</time>
          {past && <span class="wpis__znacznik">Za nami</span>}
        </p>
        <h1>{entry.data.title}</h1>
        {entry.data.venue && <p class="wpis__miejsce">{entry.data.venue}</p>}
        {entry.data.excerpt && <p class="wpis__zajawka">{entry.data.excerpt}</p>}
      </div>
    </header>

    {photo && (
      <div class="kontener">
        <Image src={photo} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="wpis__foto" />
      </div>
    )}

    <div class="kontener wpis__tresc">
      <div class="proza"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .wpis__naglowek {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: 2.5rem;
    background: radial-gradient(120% 80% at 15% 0%, rgba(var(--akcent-rgb), 0.13), transparent 60%), var(--tlo);
  }
  .wpis__powrot {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tekst-3);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }
  .wpis__powrot:hover { color: var(--akcent); }
  .wpis__data {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--akcent);
    margin-bottom: 0.9rem;
  }
  .wpis__znacznik {
    border: 1px solid var(--linia);
    color: var(--tekst-3);
    padding: 0.2rem 0.6rem;
    letter-spacing: 0.12em;
  }
  .wpis__naglowek h1 { font-size: clamp(2.25rem, 6vw, 4.25rem); max-width: 20ch; }
  .wpis__miejsce { color: var(--tekst-2); margin-bottom: 0.5rem; }
  .wpis__zajawka { max-width: 58ch; color: var(--tekst-2); font-size: 1.1875rem; margin: 0; }
  :global(.wpis__foto) { width: 100%; max-height: 32rem; object-fit: cover; border: 1px solid var(--linia); }
  .wpis__tresc { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 10vw, 7rem); }
</style>
