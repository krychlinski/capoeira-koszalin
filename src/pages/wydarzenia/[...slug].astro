---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { resolveImage } from '../../lib/media';
import { formatDateRange, isoDate } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('events');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const photo = resolveImage(entry.data.image);
const past = (entry.data.endDate ?? entry.data.startDate) < new Date();
---

<Base title={entry.data.title} description={entry.data.excerpt}>
  <article class="post">
    <header class="post__header">
      <div class="container">
        <a href="/wydarzenia/" class="post__back">← Wydarzenia</a>
        <p class="post__date">
          <time datetime={isoDate(entry.data.startDate)}>{formatDateRange(entry.data.startDate, entry.data.endDate)}</time>
          {past && <span class="post__marker">Za nami</span>}
        </p>
        <h1>{entry.data.title}</h1>
        {entry.data.venue && <p class="post__venue">{entry.data.venue}</p>}
        {entry.data.excerpt && <p class="post__excerpt">{entry.data.excerpt}</p>}
      </div>
    </header>

    {photo && (
      <div class="container">
        <Image src={photo} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="post__photo" />
      </div>
    )}

    <div class="container post__content">
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .post__header {
    padding-top: clamp(8rem, 14vw, 11rem);
    padding-bottom: 2.5rem;
    background: radial-gradient(120% 80% at 15% 0%, rgba(var(--accent-rgb), 0.13), transparent 60%), var(--bg);
  }
  .post__back {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-3);
    text-decoration: none;
    margin-bottom: 1.75rem;
  }
  .post__back:hover { color: var(--accent); }
  .post__date {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }
  .post__marker {
    border: 1px solid var(--line);
    color: var(--text-3);
    padding: 0.2rem 0.6rem;
    letter-spacing: 0.12em;
  }
  .post__header h1 { font-size: clamp(2.25rem, 6vw, 4.25rem); max-width: 20ch; }
  .post__venue { color: var(--text-2); margin-bottom: 0.5rem; }
  .post__excerpt { max-width: 58ch; color: var(--text-2); font-size: 1.1875rem; margin: 0; }
  :global(.post__photo) { width: 100%; max-height: 32rem; object-fit: cover; border: 1px solid var(--line); }
  .post__content { padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 10vw, 7rem); }
</style>
