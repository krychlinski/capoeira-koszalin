---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDateRange } from '../../lib/format';

const now = new Date();
const all = (await getCollection('events'));
const upcoming = all
  .filter((w) => (w.data.endDate ?? w.data.startDate) >= now)
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime());
const past = all
  .filter((w) => (w.data.endDate ?? w.data.startDate) < now)
  .sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());

const meta = (w: (typeof all)[number]) =>
  [formatDateRange(w.data.startDate, w.data.endDate), w.data.venue].filter(Boolean).join(' · ');
---

<Base title="Wydarzenia" description="Batizado, warsztaty i wyjazdy Akademii Capoeira Koszalin.">
  <PageHeader
    eyebrow="Kalendarz"
    title="Wydarzenia"
    description="Batizado, warsztaty z mistrzami, rody i wyjazdy. Wszystko, co dzieje się poza zwykłym treningiem."
  />

  <section class="section section--tight">
    <div class="container">
      <h2 class="list-title">Nadchodzące</h2>
      {upcoming.length === 0 ? (
        <p class="empty">Nie ma zaplanowanych wydarzeń. Zajrzyj tu za jakiś czas.</p>
      ) : (
        <div class="card-grid">
          {upcoming.map((w) => (
            <PostCard href={`/wydarzenia/${w.id}/`} title={w.data.title} meta={meta(w)} excerpt={w.data.excerpt} image={w.data.image} />
          ))}
        </div>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="section section--tight past">
      <div class="container">
        <h2 class="list-title">Za nami</h2>
        <div class="card-grid">
          {past.map((w) => (
            <PostCard href={`/wydarzenia/${w.id}/`} title={w.data.title} meta={meta(w)} excerpt={w.data.excerpt} image={w.data.image} />
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .list-title { font-size: clamp(1.25rem, 2.5vw, 1.75rem); margin-bottom: 2rem; color: var(--text-2); }
  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .past { background: var(--bg-2); border-top: 1px solid var(--line); }
  .empty { color: var(--text-3); }
</style>
