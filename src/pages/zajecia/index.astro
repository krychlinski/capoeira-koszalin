---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Schedule from '../../components/Schedule.astro';
import Notice from '../../components/Notice.astro';
import settings from '../../data/settings.json';

const classes = (await getCollection('classes')).sort((a, b) => a.data.order - b.data.order);
const offer = await getEntry('pages', 'oferta');
const Offer = offer ? (await render(offer)).Content : null;
---

<Base
  title="Zajęcia"
  description="Grafik treningów capoeiry w Koszalinie — grupy od 3 lat, młodzież, dorośli, akrobatyka i mobility."
>
  <PageHeader
    eyebrow="Grafik"
    title="Zajęcia"
    description="Trenujemy przez cały rok szkolny. Pierwszy trening jest bezpłatny i niezobowiązujący."
  />

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      <Notice />
      <Schedule classes={classes} />
      <div class="pod-grafikiem">
        <p>Nie wiesz, do której grupy pasujesz? Zadzwoń — dobierzemy ją razem.</p>
        <div class="pod-grafikiem__akcje">
          <a href="/pierwszy-trening/" class="przycisk przycisk--obrys">Przychodzisz pierwszy raz?</a>
          <a href="/cennik/" class="przycisk przycisk--obrys">Zobacz cennik</a>
          {settings.phone && (
            <a href={`tel:+48${settings.phone.replace(/\s/g, '')}`} class="przycisk">
              {settings.phone}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {Offer && (
    <section class="sekcja sekcja--ciasna oferta">
      <div class="kontener">
        <p class="nadtytul">Co robimy</p>
        <h2>Oferta</h2>
        <div class="proza proza--oferta"><Offer /></div>
      </div>
    </section>
  )}

</Base>

<style>
  .pod-grafikiem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }
  .pod-grafikiem p { margin: 0; color: var(--tekst-2); max-width: 42ch; }
  .pod-grafikiem__akcje { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .oferta { background: var(--tlo-2); border-block: 1px solid var(--linia); }
  .proza--oferta { max-width: 74ch; margin-top: 2rem; }
  .proza--oferta :global(h3) {
    font-size: 1.125rem;
    margin-top: 2.25rem;
    color: var(--akcent);
    letter-spacing: 0.04em;
  }

</style>
