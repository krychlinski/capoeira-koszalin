---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Schedule from '../../components/Schedule.astro';
import Notice from '../../components/Notice.astro';
import settings from '../../data/settings.json';

const classes = (await getCollection('classes')).sort((a, b) => a.data.order - b.data.order);
const offer = await getEntry('pages', 'oferta');
const Offer = offer ? (await render(offer)).Content : null;
---

<Base
  title="Zajęcia"
  description="Grafik treningów capoeiry w Koszalinie — grupy od 3 lat, młodzież, dorośli, akrobatyka i mobility."
>
  <PageHeader
    eyebrow="Grafik"
    title="Zajęcia"
    description="Trenujemy przez cały rok szkolny. Pierwszy trening jest bezpłatny i niezobowiązujący."
  />

  <section class="section section--tight">
    <div class="container">
      <Notice />
      <Schedule classes={classes} />
      <div class="under-schedule">
        <p>Nie wiesz, do której grupy pasujesz? Zadzwoń — dobierzemy ją razem.</p>
        <div class="under-schedule__actions">
          <a href="/pierwszy-trening/" class="button button--outline">Przychodzisz pierwszy raz?</a>
          <a href="/cennik/" class="button button--outline">Zobacz cennik</a>
          {settings.phone && (
            <a href={`tel:+48${settings.phone.replace(/\s/g, '')}`} class="button">
              {settings.phone}
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  {Offer && (
    <section class="section section--tight offer">
      <div class="container">
        <p class="eyebrow">Co robimy</p>
        <h2>Oferta</h2>
        <div class="prose prose--offer"><Offer /></div>
      </div>
    </section>
  )}

</Base>

<style>
  .under-schedule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }
  .under-schedule p { margin: 0; color: var(--text-2); max-width: 42ch; }
  .under-schedule__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .offer { background: var(--bg-2); border-block: 1px solid var(--line); }
  .prose--offer { max-width: 74ch; margin-top: 2rem; }
  .prose--offer :global(h3) {
    font-size: 1.125rem;
    margin-top: 2.25rem;
    color: var(--accent);
    letter-spacing: 0.04em;
  }

</style>
