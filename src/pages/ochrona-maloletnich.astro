---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import settings from '../data/settings.json';

const full = await getEntry('pages', 'ochrona-maloletnich');
const kids = await getEntry('pages', 'ochrona-maloletnich-dzieci');
const FullContent = full ? (await render(full)).Content : null;
const KidsContent = kids ? (await render(kids)).Content : null;

// Dane z metryczki Standardów. Osoba przyjmująca zgłoszenia ma własny telefon
// i e-mail — nie te z ustawień strony, więc stoją tu, nie w settings.json.
const contact = {
  person: 'Michał Sawiński',
  role: 'kierownik ośrodka',
  phone: '502 494 144',
  email: 'malandro@onet.eu',
};
const effectiveFrom = '3 sierpnia 2026';
---

<Base
  title="Ochrona małoletnich"
  description="Standardy Ochrony Małoletnich w Akademii Capoeira Koszalin — pełna treść oraz wersja dla dzieci."
>
  <PageHeader
    eyebrow="Formalności"
    title="Ochrona małoletnich"
    description="Standardy Ochrony Małoletnich obowiązujące w Akademii Capoeira Koszalin. Obok pełnej treści publikujemy krótszą wersję, napisaną dla dzieci i młodzieży."
  />

  <section class="section section--tight">
    <div class="container">
      <div class="meta">
        <dl class="meta__list">
          <div class="meta__row">
            <dt>Podmiot</dt>
            <dd>{settings.name}<br />{settings.address}</dd>
          </div>
          <div class="meta__row">
            <dt>Obowiązują od</dt>
            <dd>{effectiveFrom}</dd>
          </div>
          <div class="meta__row">
            <dt>Wdrożenie Standardów</dt>
            <dd>{contact.person}, {contact.role}</dd>
          </div>
          <div class="meta__row">
            <dt>Zgłoszenia przyjmuje</dt>
            <dd>
              {contact.person}, {contact.role}<br />
              <a href={`tel:+48${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a><br />
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </dd>
          </div>
        </dl>
        <p class="meta__note">
          Jeżeli zagrożone jest życie lub zdrowie dziecka, w pierwszej kolejności zadzwoń pod{' '}
          <a href="tel:112">112</a>. Bezpłatny telefon zaufania dla dzieci i młodzieży:{' '}
          <a href="tel:116111">116 111</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tight kids">
    <div class="container">
      <p class="eyebrow">Wersja dla dzieci</p>
      <h2 class="kids__title">Zasady, dzięki którym na Akademii ma być bezpiecznie</h2>
      {KidsContent ? <div class="prose prose--kids"><KidsContent /></div> : <p class="empty">Brak treści.</p>}
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <p class="eyebrow">Pełna treść</p>
      <h2 class="full__title">Standardy Ochrony Małoletnich</h2>
      {FullContent ? <div class="prose prose--terms"><FullContent /></div> : <p class="empty">Brak treści.</p>}
    </div>
  </section>
</Base>

<style>
  .meta {
    max-width: 68ch;
    border: 1px solid var(--line);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  .meta__list { margin: 0; display: grid; gap: 1.25rem; }
  @media (min-width: 640px) {
    .meta__list { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; }
  }
  .meta__row dt {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: 0.4rem;
  }
  /* Adres w ustawieniach jest łamany znakiem nowej linii — tak jak w stopce. */
  .meta__row dd { margin: 0; color: var(--text-2); font-size: 0.9375rem; line-height: 1.6; white-space: pre-line; }
  .meta__row a { color: var(--accent); text-decoration: none; }
  .meta__row a:hover { text-decoration: underline; }
  .meta__note {
    margin: 1.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--text-3);
  }
  .meta__note a { color: var(--accent); }

  /* Wersja dla dzieci ma czytać się lżej niż paragrafy — większy tekst
     i delikatne tło odróżniające ją od formalnej części strony. */
  .kids {
    background: var(--bg-2);
    border-block: 1px solid var(--line);
  }
  .kids__title,
  .full__title {
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    max-width: 22ch;
    margin: 0 0 2rem;
  }
  .prose--kids { font-size: 1.0625rem; }
  .prose--kids :global(h3) {
    font-size: 1.0625rem;
    color: var(--text);
    letter-spacing: 0;
    margin-top: 2.25rem;
  }

  .prose--terms :global(h2) {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .prose--terms :global(h2:first-child) { margin-top: 0; padding-top: 0; border-top: 0; }
  .prose--terms { font-size: 1rem; }

  .empty { color: var(--text-3); }
</style>
