---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import { obraz } from '../lib/media';

const strona = await getEntry('strony', 'o-nas');
const Tresc = strona ? (await render(strona)).Content : null;
const foto = obraz(strona?.data.zdjecie);
---

<Baza tytul={strona?.data.tytul ?? 'O nas'}>
  <NaglowekStrony nadtytul="Grupa" tytul={strona?.data.tytul ?? 'O nas'} opis={strona?.data.naglowek} />

  {foto && (
    <div class="kontener">
      <Image src={foto} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="foto" />
    </div>
  )}

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {Tresc ? (
        <div class="proza"><Tresc /></div>
      ) : (
        <p class="pusto">Treść tej strony uzupełnisz w panelu, w sekcji „Strony”.</p>
      )}
    </div>
  </section>
</Baza>

<style>
  :global(.foto) {
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    border: 1px solid var(--linia);
    margin-top: 2.5rem;
    filter: grayscale(0.35);
  }
  .pusto { color: var(--tekst-3); }
</style>
