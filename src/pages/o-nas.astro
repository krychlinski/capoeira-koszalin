---
import { getEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { resolveImage } from '../lib/media';

const page = await getEntry('pages', 'o-nas');
const Content = page ? (await render(page)).Content : null;
const photo = resolveImage(page?.data.image);

const list = (await getCollection('instructors')).sort((a, b) => a.data.order - b.data.order);
const instructors = await Promise.all(
  list.map(async (i) => ({ entry: i, photo: resolveImage(i.data.image), Bio: (await render(i)).Content }))
);
---

<Base title={page?.data.title ?? 'O nas'} description="Akademia Capoeira Koszalin — kim jesteśmy i kto prowadzi treningi.">
  <PageHeader eyebrow="Grupa" title={page?.data.title ?? 'O nas'} description={page?.data.heading} />

  {photo && (
    <div class="kontener">
      <Image src={photo} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="foto" />
    </div>
  )}

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {Content ? (
        <div class="proza"><Content /></div>
      ) : (
        <p class="pusto">Treść tej strony uzupełnisz w panelu, w sekcji „Strony”.</p>
      )}
    </div>
  </section>

  {instructors.length > 0 && (
    <section class="sekcja sekcja--ciasna kadra">
      <div class="kontener">
        <p class="nadtytul">Kto prowadzi</p>
        <h2>Instruktorzy</h2>

        <div class="lista">
          {instructors.map(({ entry, photo: portrait, Bio }) => (
            <article class={portrait ? 'osoba' : 'osoba osoba--bez-zdjecia'}>
              {portrait && (
                <div class="osoba__foto">
                  <Image src={portrait} alt={entry.data.name} widths={[400, 800]} sizes="(max-width: 800px) 100vw, 300px" loading="lazy" />
                </div>
              )}
              <div class="osoba__tresc">
                {entry.data.apelido && <p class="osoba__apelido">{entry.data.apelido}</p>}
                <h3 class="osoba__imie">{entry.data.name}</h3>
                {entry.data.corda && <p class="osoba__stopien">{entry.data.corda}</p>}
                <div class="proza"><Bio /></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  :global(.foto) {
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    border: 1px solid var(--linia);
    margin-top: 2.5rem;
    filter: grayscale(0.35);
  }
  .pusto { color: var(--tekst-3); }

  .kadra { background: var(--tlo-2); border-top: 1px solid var(--linia); }
  .lista { display: grid; gap: 3rem; margin-top: 2.5rem; }
  .osoba {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 800px) { .osoba { grid-template-columns: 1fr; } }
  /* Bez portretu nie zostaje pusta ramka ani odstęp po niej — tekst zajmuje
     całą szerokość. Kolumna wraca sama, gdy zdjęcie się pojawi. */
  .osoba--bez-zdjecia { grid-template-columns: 1fr; }

  .osoba__foto { aspect-ratio: 3 / 4; overflow: hidden; border: 1px solid var(--linia); }
  .osoba__foto :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.5) contrast(1.05); }

  .osoba__apelido {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--akcent);
    margin: 0 0 0.5rem;
  }
  .osoba__imie { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 0.35rem; }
  .osoba__stopien { color: var(--tekst-3); font-size: 0.9375rem; margin-bottom: 1.25rem; }
</style>
