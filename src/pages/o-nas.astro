---
import { getEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Baza from '../layouts/Baza.astro';
import NaglowekStrony from '../components/NaglowekStrony.astro';
import { obraz } from '../lib/media';

const strona = await getEntry('strony', 'o-nas');
const Tresc = strona ? (await render(strona)).Content : null;
const foto = obraz(strona?.data.zdjecie);

const lista = (await getCollection('instruktorzy')).sort((a, b) => a.data.kolejnosc - b.data.kolejnosc);
const instruktorzy = await Promise.all(
  lista.map(async (i) => ({ wpis: i, foto: obraz(i.data.zdjecie), Biogram: (await render(i)).Content }))
);
---

<Baza tytul={strona?.data.tytul ?? 'O nas'} opis="Akademia Capoeira Koszalin — kim jesteśmy i kto prowadzi treningi.">
  <NaglowekStrony nadtytul="Grupa" tytul={strona?.data.tytul ?? 'O nas'} opis={strona?.data.naglowek} />

  {foto && (
    <div class="kontener">
      <Image src={foto} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="foto" />
    </div>
  )}

  <section class="sekcja sekcja--ciasna">
    <div class="kontener">
      {Tresc ? (
        <div class="proza"><Tresc /></div>
      ) : (
        <p class="pusto">Treść tej strony uzupełnisz w panelu, w sekcji „Strony”.</p>
      )}
    </div>
  </section>

  {instruktorzy.length > 0 && (
    <section class="sekcja sekcja--ciasna kadra">
      <div class="kontener">
        <p class="nadtytul">Kto prowadzi</p>
        <h2>Instruktorzy</h2>

        <div class="lista">
          {instruktorzy.map(({ wpis, foto: portret, Biogram }) => (
            <article class={portret ? 'osoba' : 'osoba osoba--bez-zdjecia'}>
              {portret && (
                <div class="osoba__foto">
                  <Image src={portret} alt={wpis.data.imie} widths={[400, 800]} sizes="(max-width: 800px) 100vw, 300px" loading="lazy" />
                </div>
              )}
              <div class="osoba__tresc">
                {wpis.data.apelido && <p class="osoba__apelido">{wpis.data.apelido}</p>}
                <h3 class="osoba__imie">{wpis.data.imie}</h3>
                {wpis.data.stopien && <p class="osoba__stopien">{wpis.data.stopien}</p>}
                <div class="proza"><Biogram /></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Baza>

<style>
  :global(.foto) {
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    border: 1px solid var(--linia);
    margin-top: 2.5rem;
    filter: grayscale(0.35);
  }
  .pusto { color: var(--tekst-3); }

  .kadra { background: var(--tlo-2); border-top: 1px solid var(--linia); }
  .lista { display: grid; gap: 3rem; margin-top: 2.5rem; }
  .osoba {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 800px) { .osoba { grid-template-columns: 1fr; } }
  /* Bez portretu nie zostaje pusta ramka ani odstęp po niej — tekst zajmuje
     całą szerokość. Kolumna wraca sama, gdy zdjęcie się pojawi. */
  .osoba--bez-zdjecia { grid-template-columns: 1fr; }

  .osoba__foto { aspect-ratio: 3 / 4; overflow: hidden; border: 1px solid var(--linia); }
  .osoba__foto :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.5) contrast(1.05); }

  .osoba__apelido {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--akcent);
    margin: 0 0 0.5rem;
  }
  .osoba__imie { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 0.35rem; }
  .osoba__stopien { color: var(--tekst-3); font-size: 0.9375rem; margin-bottom: 1.25rem; }
</style>
