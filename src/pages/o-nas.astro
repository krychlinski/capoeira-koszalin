---
import { getEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { resolveImage } from '../lib/media';

const page = await getEntry('pages', 'o-nas');
const Content = page ? (await render(page)).Content : null;
const photo = resolveImage(page?.data.image);

const list = (await getCollection('instructors')).sort((a, b) => a.data.order - b.data.order);
const instructors = await Promise.all(
  list.map(async (i) => ({ entry: i, photo: resolveImage(i.data.image), Bio: (await render(i)).Content }))
);
---

<Base title={page?.data.title ?? 'O nas'} description="Akademia Capoeira Koszalin — kim jesteśmy i kto prowadzi treningi.">
  <PageHeader eyebrow="Grupa" title={page?.data.title ?? 'O nas'} description={page?.data.heading} />

  {photo && (
    <div class="container">
      <Image src={photo} alt="" widths={[800, 1200, 1600]} sizes="(max-width: 1180px) 100vw, 1180px" class="photo" />
    </div>
  )}

  <section class="section section--tight">
    <div class="container">
      {Content ? (
        <div class="prose"><Content /></div>
      ) : (
        <p class="empty">Treść tej strony uzupełnisz w panelu, w sekcji „Strony”.</p>
      )}
    </div>
  </section>

  {instructors.length > 0 && (
    <section class="section section--tight staff">
      <div class="container">
        <p class="eyebrow">Kto prowadzi</p>
        <h2>Instruktorzy</h2>

        <div class="list">
          {instructors.map(({ entry, photo: portrait, Bio }) => (
            <article class={portrait ? 'person' : 'person person--no-photo'}>
              {portrait && (
                <div class="person__photo">
                  <Image src={portrait} alt={entry.data.name} widths={[400, 800]} sizes="(max-width: 800px) 100vw, 300px" loading="lazy" />
                </div>
              )}
              <div class="person__content">
                {entry.data.apelido && <p class="person__apelido">{entry.data.apelido}</p>}
                <h3 class="person__name">{entry.data.name}</h3>
                {entry.data.corda && <p class="person__corda">{entry.data.corda}</p>}
                <div class="prose"><Bio /></div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  :global(.photo) {
    width: 100%;
    max-height: 26rem;
    object-fit: cover;
    border: 1px solid var(--line);
    margin-top: 2.5rem;
    filter: grayscale(0.35);
  }
  .empty { color: var(--text-3); }

  .staff { background: var(--bg-2); border-top: 1px solid var(--line); }
  .list { display: grid; gap: 3rem; margin-top: 2.5rem; }
  .person {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }
  @media (max-width: 800px) { .person { grid-template-columns: 1fr; } }
  /* Bez portretu nie zostaje pusta ramka ani odstęp po niej — tekst zajmuje
     całą szerokość. Kolumna wraca sama, gdy zdjęcie się pojawi. */
  .person--no-photo { grid-template-columns: 1fr; }

  .person__photo { aspect-ratio: 3 / 4; overflow: hidden; border: 1px solid var(--line); }
  .person__photo :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.5) contrast(1.05); }

  .person__apelido {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.5rem;
  }
  .person__name { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 0.35rem; }
  .person__corda { color: var(--text-3); font-size: 0.9375rem; margin-bottom: 1.25rem; }
</style>
