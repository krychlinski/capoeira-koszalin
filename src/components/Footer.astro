---
import { Image } from 'astro:assets';
import logoPelne from '../assets/logo-pelne.png';
import settings from '../data/settings.json';

const year = new Date().getFullYear();
const social = [
  { href: settings.facebook, text: 'Facebook' },
  { href: settings.instagram, text: 'Instagram' },
  { href: settings.youtube, text: 'YouTube' },
].filter((s) => s.href);
const telHref = settings.phone ? `tel:+48${settings.phone.replace(/\s/g, '')}` : null;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Image src={logoPelne} alt={settings.name} widths={[260, 520]} sizes="240px" loading="lazy" class="footer__logo" />
      {settings.group && <p class="footer__group">{settings.group}</p>}
    </div>

    <div class="footer__column">
      <h4 class="footer__title">Kontakt</h4>
      {telHref && <a href={telHref} class="footer__link">{settings.phone}</a>}
      {settings.email && <a href={`mailto:${settings.email}`} class="footer__link">{settings.email}</a>}
      {settings.address && <p class="footer__text">{settings.address}</p>}
    </div>

    {social.length > 0 && (
      <div class="footer__column">
        <h4 class="footer__title">Znajdź nas</h4>
        {social.map((s) => (
          <a href={s.href} class="footer__link" target="_blank" rel="noopener noreferrer">{s.text}</a>
        ))}
      </div>
    )}

    <div class="footer__column">
      <h4 class="footer__title">Strona</h4>
      <a href="/zajecia/" class="footer__link">Grafik zajęć</a>
      <a href="/cennik/" class="footer__link">Cennik</a>
      <a href="/faq/" class="footer__link">Częste pytania</a>
      <a href="/o-nas/" class="footer__link">O nas</a>
      <a href="/regulamin/" class="footer__link">Regulamin</a>
      <a href="/prywatnosc/" class="footer__link">Prywatność</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {settings.name}</p>
    <p class="footer__axe">Axé!</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    /* Poblask od dołu, słabszy niż w bloku wezwania do działania — ten stoi
       wyżej na stronie i ma zostać mocniejszy. */
    background:
      radial-gradient(70% 100% at 15% 100%, rgba(var(--accent-rgb), 0.1), transparent 70%),
      var(--bg-2);
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  @media (max-width: 820px) {
    .footer__inner { grid-template-columns: 1fr 1fr; }
    .footer__brand { grid-column: 1 / -1; }
  }

  .footer :global(.footer__logo) {
    width: 240px;
    max-width: 100%;
    height: auto;
    margin-bottom: 0.85rem;
  }
  .footer__group {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0;
  }

  .footer__title {
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    color: var(--text-3);
    margin-bottom: 1rem;
  }
  .footer__link,
  .footer__text {
    display: block;
    color: var(--text-2);
    text-decoration: none;
    margin-bottom: 0.55rem;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }
  .footer__link:hover { color: var(--accent); }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-block: 1.5rem;
    font-size: 0.8125rem;
    color: var(--text-3);
  }
  .footer__bottom p { margin: 0; }
  .footer__axe {
    font-family: var(--font-display);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--accent-muted);
  }
</style>
