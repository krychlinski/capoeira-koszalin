---
import { pobierzPosty, skroc } from '../lib/facebook';
import { dataPl } from '../lib/format';
import ustawienia from '../data/ustawienia.json';

const posty = await pobierzPosty();
---

{posty.length > 0 && (
  <section class="posty">
    <div class="posty__naglowek">
      <div>
        <p class="nadtytul">Prosto z Facebooka</p>
        <h2>Ostatnie wpisy</h2>
      </div>
      {ustawienia.facebook && (
        <a href={ustawienia.facebook} class="przycisk przycisk--obrys" target="_blank" rel="noopener noreferrer">
          Zobacz profil
        </a>
      )}
    </div>

    <ul class="posty__lista">
      {posty.map((post) => {
        const { tekst, obciety } = skroc(post.tresc);
        return (
          <li class="post">
            <time class="post__data" datetime={post.data.toISOString().slice(0, 10)}>
              {dataPl(post.data)}
            </time>
            <p class="post__tresc">
              {tekst}{obciety && '…'}
            </p>
            <a class="post__link" href={post.odnosnik} target="_blank" rel="noopener noreferrer">
              {obciety ? 'Czytaj całość na Facebooku' : 'Zobacz na Facebooku'}
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}

<style>
  .posty__naglowek {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
  }
  .posty__naglowek h2 { margin: 0; }

  .posty__lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--linia); }

  .post {
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--linia);
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 2rem;
    align-items: start;
  }
  @media (max-width: 700px) {
    .post { grid-template-columns: 1fr; gap: 0.6rem; }
  }

  .post__data {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--akcent-scisz);
    padding-top: 0.2rem;
  }
  .post__tresc {
    margin: 0 0 0.75rem;
    color: var(--tekst-2);
    white-space: pre-line;
    max-width: 62ch;
  }
  .post__link {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--akcent);
    text-decoration: none;
    grid-column: 2;
  }
  @media (max-width: 700px) { .post__link { grid-column: 1; } }
  .post__link:hover { color: var(--akcent-jasny); text-decoration: underline; }
</style>
