---
import { Image } from 'astro:assets';
import { obraz } from '../lib/media';
import { ileZdjec } from '../lib/format';

interface Props {
  href: string;
  tytul: string;
  meta?: string;
  zajawka?: string;
  /** Zamiast zajawki: pierwsze pozycje wypunktowania z wpisu. */
  punkty?: string[];
  zdjecie?: string;
  /** Zdjęcie leżące już w public/ — omija optymalizator, bo pobiera je integracja. */
  zdjecieUrl?: string;
  /** Ile zdjęć ma wpis — pokazujemy licznik na kaflu przy albumie. */
  liczbaZdjec?: number;
}
const { href, tytul, meta, zajawka, punkty, zdjecie, zdjecieUrl, liczbaZdjec = 0 } = Astro.props;
const foto = obraz(zdjecie);
---

<a class="karta" href={href}>
  {(foto || zdjecieUrl) && (
    <div class="karta__foto">
      {foto ? (
        <Image src={foto} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 380px" loading="lazy" />
      ) : (
        <img src={zdjecieUrl} alt="" loading="lazy" decoding="async" />
      )}
      {liczbaZdjec > 1 && <span class="karta__licznik">{ileZdjec(liczbaZdjec)}</span>}
    </div>
  )}
  <div class="karta__tresc">
    {meta && <p class="karta__meta">{meta}</p>}
    <h3 class="karta__tytul">{tytul}</h3>
    {punkty && punkty.length > 0 ? (
      <ul class="karta__punkty">{punkty.map((x) => <li>{x}</li>)}</ul>
    ) : (
      zajawka && <p class="karta__zajawka">{zajawka}</p>
    )}
    <span class="karta__wiecej">Czytaj dalej</span>
  </div>
</a>

<style>
  .karta {
    display: flex;
    flex-direction: column;
    background: var(--tlo-2);
    border: 1px solid var(--linia);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .karta:hover { border-color: var(--akcent-ciemny); transform: translateY(-4px); }

  .karta__foto { aspect-ratio: 3 / 2; overflow: hidden; background: var(--tlo-3); position: relative; }
  .karta__licznik {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    background: rgba(11, 11, 12, 0.82);
    color: var(--tekst);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
  }
  .karta__foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35);
    transition: transform 0.5s ease, filter 0.35s ease;
  }
  .karta:hover .karta__foto :global(img) { transform: scale(1.05); filter: grayscale(0); }

  .karta__zastepnik {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(70% 70% at 30% 30%, rgba(var(--akcent-rgb), 0.16), transparent 70%),
      var(--tlo-3);
  }

  .karta__tresc { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }

  .karta__meta {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--akcent);
    margin: 0 0 0.6rem;
  }
  .karta__tytul { font-size: 1.3rem; margin: 0 0 0.7rem; }
  .karta__zajawka { color: var(--tekst-2); font-size: 0.9375rem; margin: 0 0 1.25rem; }
  .karta__punkty {
    list-style: none;
    color: var(--tekst-2);
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .karta__punkty li {
    position: relative;
    padding-left: 0.95rem;
    margin-bottom: 0.35rem;
  }
  .karta__punkty li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    background: var(--akcent);
  }
  .karta__wiecej {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tekst-3);
  }
  .karta:hover .karta__wiecej { color: var(--akcent); }
</style>
