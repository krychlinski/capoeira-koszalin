---
/**
 * „Bądź na bieżąco” — blok zapisujący przeglądarkę na powiadomienia o nowych wpisach.
 *
 * Cały blok startuje ukryty i pokazuje go dopiero skrypt, gdy stwierdzi, że przeglądarka
 * powiadomienia obsługuje. Inaczej połowa odwiedzających patrzyłaby na zaproszenie do
 * czegoś, czego nie da się u nich włączyć.
 *
 * Napisy siedzą w kodzie, a nie w panelu, bo zmieniają się razem ze stanem przycisku
 * i są częścią mechanizmu, nie treścią do redagowania.
 *
 * Klucz publiczny VAPID jest jawny z założenia: przeglądarka musi go dostać, żeby
 * się zapisać. Tajny jest wyłącznie klucz prywatny i ten siedzi w sekretach Workera.
 */
const WORKER = 'https://capoeira-push.kacper-rychlinski.workers.dev';
const VAPID_PUBLIC = 'BEH4Ql3QsZkHA9EUNHnTJTIKxNWDpyIOG22ctTxO9vmKhvY6g9kGgN6TtYN-V6eoL83Qv90npcXd1ZKR9bGPXBM';
---

<aside class="bell" data-bell hidden>
  <div class="bell__text">
    <p class="eyebrow">Bądź na bieżąco</p>
    <h2 class="bell__heading" data-bell-heading>Nie przegap nowego wpisu</h2>
    <p class="bell__lead" data-bell-lead>
      Odwołany trening, termin batizado, zdjęcia z rody — damy znać w przeglądarce, gdy tylko
      pojawi się nowy wpis. Nie trzeba ciągle odświeżać tej strony.
    </p>
  </div>

  <div class="bell__action">
    <button class="button bell__button" data-bell-toggle type="button" aria-pressed="false">
      <svg class="bell__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M12 2a6 6 0 0 0-6 6v3.6l-1.7 3.2A1 1 0 0 0 5.2 16h13.6a1 1 0 0 0 .9-1.2L18 11.6V8a6 6 0 0 0-6-6z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
        <path d="M9.5 19a2.5 2.5 0 0 0 5 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
      <span data-bell-label>Włącz powiadomienia</span>
    </button>
    <p class="bell__note" data-bell-note role="status">W każdej chwili możesz je wyłączyć.</p>
  </div>
</aside>

<style>
  .bell {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--line);
    /* Poblask od strony przycisku — prowadzi oko tam, gdzie się klika.
       Słabszy niż w bloku wezwania na stronie głównej, żeby aktualności
       zostały bohaterem tej strony, a nie dzwoneczek. */
    background:
      radial-gradient(80% 120% at 100% 50%, rgba(var(--accent-rgb), 0.09), transparent 70%),
      var(--bg-2);
  }
  @media (max-width: 720px) {
    .bell { grid-template-columns: 1fr; align-items: start; }
  }

  .bell__text :global(.eyebrow) { margin-bottom: 0.75rem; }
  .bell__heading {
    font-size: clamp(1.25rem, 2.6vw, 1.75rem);
    margin: 0 0 0.6rem;
  }
  .bell__lead {
    margin: 0;
    max-width: 52ch;
    font-size: 0.9375rem;
    color: var(--text-2);
  }
  /* Kroki instrukcji dla iPhone'a — wstawiane przez skrypt, więc :global. */
  .bell__lead :global(.bell__steps) {
    margin: 0.9rem 0 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.45rem;
  }
  .bell__lead :global(.bell__steps li) { padding-left: 0.2rem; }
  .bell__lead :global(.bell__steps strong),
  .bell__lead :global(strong) { color: var(--text); font-weight: 500; }

  .bell__lead :global(.bell__how) { margin-top: 0.9rem; }
  .bell__lead :global(.bell__how summary) {
    cursor: pointer;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .bell__lead :global(.bell__how[open] summary) { margin-bottom: 0.35rem; }
  .bell__lead :global(.bell__how .bell__steps) { margin-top: 0.6rem; }

  /* :global, bo ten przycisk wstawia skrypt — zakresowe style Astro dokładają
     atrybut przy budowaniu i nie obejmują znaczników powstałych w przeglądarce. */
  .bell__note :global(.bell__dismiss) {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .bell__note :global(.bell__dismiss:hover) { color: var(--accent); }

  .bell__action { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
  /* Przycisk nie rozpycha się na całą szerokość kolumny na telefonie — tekst
     pod nim jest dłuższy i inaczej ciągnąłby go przez cały ekran. */
  .bell__button { white-space: nowrap; }
  /* Klasa .button ustawia display: inline-flex, co BIJE domyślne display: none
     od atrybutu [hidden] — bez tego ukrywanie przycisku nic nie robi. */
  .bell__button[hidden] { display: none; }
  .bell__icon { flex: none; }

  /* Powiadomienia włączone — przycisk przestaje zapraszać i staje się stanem.
     Wypełniona zieleń zostawiona jest dla „zrób to”, obrys dla „zrobione”. */
  .bell__button[aria-pressed='true'] {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent-muted);
  }
  .bell__button[aria-pressed='true']:hover {
    background: transparent;
    color: var(--accent-light);
    border-color: var(--accent);
  }
  .bell__button:disabled {
    background: transparent;
    color: var(--text-3);
    border-color: var(--line);
    cursor: default;
    transform: none;
  }
  .bell__button[data-busy] { opacity: 0.6; }

  .bell__note {
    margin: 0;
    max-width: 34ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--text-3);
  }
  .bell__note:empty { display: none; }
</style>

<script is:inline define:vars={{ WORKER, VAPID_PUBLIC }}>
  (() => {
    const root = document.querySelector('[data-bell]');
    if (!root) return;

    const button = root.querySelector('[data-bell-toggle]');
    const label = root.querySelector('[data-bell-label]');
    const note = root.querySelector('[data-bell-note]');
    const heading = root.querySelector('[data-bell-heading]');
    const lead = root.querySelector('[data-bell-lead]');

    const supported =
      'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

    // Na iPhonie web push działa WYŁĄCZNIE w stronie dodanej do ekranu głównego.
    // W zwykłej karcie Safari PushManager często w ogóle nie istnieje, więc bez tego
    // rozróżnienia blok po prostu znikał i nikt nie wiedział dlaczego.
    const iOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    const standalone =
      window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;

    // Zapamiętanie „już to wiem” — w zwykłej karcie Safari NIE DA SIĘ sprawdzić,
    // czy ktoś ma już ikonę na ekranie głównym; iOS nie udostępnia takiej
    // informacji. Bez tego blok w kółko instruuje kogoś, kto dawno zainstalował.
    const SCHOWANE = 'bell-ios-schowane';
    const pamiec = {
      czyta: () => {
        try {
          return localStorage.getItem(SCHOWANE) === '1';
        } catch {
          return false;
        }
      },
      zapisz: () => {
        try {
          localStorage.setItem(SCHOWANE, '1');
        } catch {
          // Tryb prywatny — trudno, przy następnym wejściu pokaże się znowu.
        }
      },
    };

    if (!supported) {
      if (iOS && !standalone && !pamiec.czyta()) {
        root.hidden = false;
        // Nie zakładamy, że ikony jeszcze nie ma. Najpierw zdanie, które działa
        // w obu wypadkach, a instrukcja instalacji jest zwinięta — kto ją już
        // przeszedł, nie musi na nią patrzeć.
        heading.textContent = 'Powiadomienia działają z ekranu głównego';
        lead.innerHTML =
          'Safari nie wysyła powiadomień ze zwykłej karty — nie da się ich włączyć nigdzie w ustawieniach. ' +
          '<strong>Masz już ikonę Akademii na ekranie głównym? Otwórz stronę z niej i włącz dzwoneczek tam.</strong>' +
          '<details class="bell__how">' +
          '<summary>Nie mam jeszcze ikony — jak ją dodać</summary>' +
          '<ol class="bell__steps">' +
          '<li>Stuknij przycisk udostępniania (kwadrat ze strzałką w górę).</li>' +
          '<li>Wybierz z listy <strong>„Do ekranu początkowego”</strong>. Jeśli tej pozycji nie ma, zjedź na sam dół listy, stuknij <strong>„Edytuj czynności…”</strong> i dodaj ją zielonym plusem.</li>' +
          '<li>Otwórz stronę z nowej ikony — nie z Safari.</li>' +
          '<li>Wróć tutaj: przycisk będzie już działał.</li>' +
          '</ol>' +
          '</details>';
        button.hidden = true;
        note.innerHTML =
          'Wymaga iOS 16.4 lub nowszego. <button type="button" class="bell__dismiss" data-bell-dismiss>Nie pokazuj tego więcej</button>';
        root.querySelector('[data-bell-dismiss]')?.addEventListener('click', () => {
          pamiec.zapisz();
          root.hidden = true;
        });
      }
      return;
    }

    root.hidden = false;

    const keyBytes = (base64) => {
      const padded = (base64 + '='.repeat((4 - (base64.length % 4)) % 4))
        .replace(/-/g, '+')
        .replace(/_/g, '/');
      const raw = atob(padded);
      return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
    };

    const render = (on, message) => {
      button.setAttribute('aria-pressed', String(on));
      label.textContent = on ? 'Powiadomienia włączone' : 'Włącz powiadomienia';
      heading.textContent = on ? 'Jesteś na bieżąco' : 'Nie przegap nowego wpisu';
      note.textContent =
        message !== undefined
          ? message
          : on
            ? 'Damy znać, gdy pojawi się nowy wpis. W każdej chwili możesz je wyłączyć.'
            : 'W każdej chwili możesz je wyłączyć.';
    };

    const existing = async () => {
      const reg = await navigator.serviceWorker.getRegistration();
      return reg ? reg.pushManager.getSubscription() : null;
    };

    const enable = async () => {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        render(
          false,
          'Przeglądarka zablokowała powiadomienia dla tej strony. Możesz to zmienić w jej ustawieniach.'
        );
        return;
      }

      const reg = await navigator.serviceWorker.register('/sw.js');
      await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: keyBytes(VAPID_PUBLIC),
      });

      // Wysyłamy WYŁĄCZNIE adres endpointu. Klucze szyfrujące z subskrypcji
      // zostają w przeglądarce — nie są nam potrzebne, bo powiadomienia idą puste.
      const res = await fetch(WORKER + '/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpoint: sub.endpoint }),
      });
      if (!res.ok) throw new Error('zapis nie powiódł się');

      render(true);
    };

    const disable = async () => {
      const sub = await existing();
      if (sub) {
        await fetch(WORKER + '/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint }),
        }).catch(() => {});
        await sub.unsubscribe();
      }
      render(false, 'Powiadomienia wyłączone. Możesz je włączyć z powrotem, kiedy zechcesz.');
    };

    button.addEventListener('click', async () => {
      if (button.dataset.busy) return;
      button.dataset.busy = '1';
      try {
        const on = button.getAttribute('aria-pressed') === 'true';
        await (on ? disable() : enable());
      } catch {
        render(
          button.getAttribute('aria-pressed') === 'true',
          'Nie udało się. Spróbuj jeszcze raz za chwilę.'
        );
      } finally {
        delete button.dataset.busy;
      }
    });

    existing().then((sub) => render(Boolean(sub) && Notification.permission === 'granted'));
  })();
</script>
