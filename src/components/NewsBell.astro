---
/**
 * Dzwoneczek — zapisuje przeglądarkę na powiadomienia o nowych aktualnościach.
 *
 * Klucz publiczny VAPID jest jawny z założenia: przeglądarka musi go dostać, żeby
 * się zapisać. Tajny jest wyłącznie klucz prywatny i ten siedzi w sekretach Workera.
 */
const WORKER = 'https://capoeira-push.kacper-rychlinski.workers.dev';
const VAPID_PUBLIC = 'BEH4Ql3QsZkHA9EUNHnTJTIKxNWDpyIOG22ctTxO9vmKhvY6g9kGgN6TtYN-V6eoL83Qv90npcXd1ZKR9bGPXBM';
---

<div class="bell" data-bell hidden>
  <button class="bell__button" data-bell-toggle type="button" aria-pressed="false">
    <svg class="bell__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path
        d="M12 2a6 6 0 0 0-6 6v3.6l-1.7 3.2A1 1 0 0 0 5.2 16h13.6a1 1 0 0 0 .9-1.2L18 11.6V8a6 6 0 0 0-6-6z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linejoin="round"
      />
      <path d="M9.5 19a2.5 2.5 0 0 0 5 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <span data-bell-label>Powiadom mnie o nowych wpisach</span>
  </button>
  <p class="bell__note" data-bell-note role="status"></p>
</div>

<style>
  .bell { margin-top: 1.5rem; }

  .bell__button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.2rem;
    background: transparent;
    color: var(--text-2);
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .bell__button:hover:not(:disabled) { color: var(--accent); border-color: var(--accent-muted); }
  .bell__button:disabled { cursor: default; opacity: 0.6; }

  /* Włączone powiadomienia — dzwonek świeci akcentem, żeby stan było widać
     bez czytania podpisu. */
  .bell__button[aria-pressed='true'] { color: var(--accent); border-color: var(--accent-muted); }

  .bell__icon { flex: none; }
  .bell__button[data-busy] .bell__icon { opacity: 0.4; }

  .bell__note {
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-3);
    max-width: 46ch;
  }
  .bell__note:empty { display: none; }
</style>

<script is:inline define:vars={{ WORKER, VAPID_PUBLIC }}>
  (() => {
    const root = document.querySelector('[data-bell]');
    if (!root) return;

    const button = root.querySelector('[data-bell-toggle]');
    const label = root.querySelector('[data-bell-label]');
    const note = root.querySelector('[data-bell-note]');

    const supported =
      'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;

    // Na iPhonie web push działa WYŁĄCZNIE w stronie dodanej do ekranu głównego.
    // W zwykłej karcie Safari PushManager często w ogóle nie istnieje, więc bez tego
    // rozróżnienia dzwoneczek po prostu znikał i nikt nie wiedział dlaczego.
    const iOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
    const standalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;

    if (!supported) {
      if (iOS && !standalone) {
        root.hidden = false;
        button.disabled = true;
        label.textContent = 'Powiadomienia na iPhonie';
        note.textContent =
          'Safari wysyła powiadomienia tylko ze strony dodanej do ekranu głównego. Otwórz menu udostępniania i wybierz „Do ekranu początkowego”, potem wróć tutaj.';
      }
      return;
    }

    root.hidden = false;

    const keyBytes = (base64) => {
      const padded = (base64 + '='.repeat((4 - (base64.length % 4)) % 4))
        .replace(/-/g, '+')
        .replace(/_/g, '/');
      const raw = atob(padded);
      return Uint8Array.from([...raw].map((c) => c.charCodeAt(0)));
    };

    const render = (on, message) => {
      button.setAttribute('aria-pressed', String(on));
      label.textContent = on ? 'Powiadomienia włączone' : 'Powiadom mnie o nowych wpisach';
      note.textContent = message || '';
    };

    const existing = async () => {
      const reg = await navigator.serviceWorker.getRegistration();
      return reg ? reg.pushManager.getSubscription() : null;
    };

    const enable = async () => {
      const permission = await Notification.requestPermission();
      if (permission !== 'granted') {
        render(false, 'Przeglądarka zablokowała powiadomienia. Możesz to zmienić w jej ustawieniach dla tej strony.');
        return;
      }

      const reg = await navigator.serviceWorker.register('/sw.js');
      await navigator.serviceWorker.ready;
      const sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: keyBytes(VAPID_PUBLIC),
      });

      // Wysyłamy WYŁĄCZNIE adres endpointu. Klucze szyfrujące z subskrypcji
      // zostają w przeglądarce — nie są nam potrzebne, bo powiadomienia idą puste.
      const res = await fetch(WORKER + '/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ endpoint: sub.endpoint }),
      });
      if (!res.ok) throw new Error('zapis nie powiódł się');

      render(true, 'Damy znać, gdy pojawi się nowy wpis. Możesz to wyłączyć w każdej chwili.');
    };

    const disable = async () => {
      const sub = await existing();
      if (sub) {
        await fetch(WORKER + '/unsubscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint: sub.endpoint }),
        }).catch(() => {});
        await sub.unsubscribe();
      }
      render(false, 'Powiadomienia wyłączone.');
    };

    button.addEventListener('click', async () => {
      if (button.dataset.busy) return;
      button.dataset.busy = '1';
      try {
        const on = button.getAttribute('aria-pressed') === 'true';
        await (on ? disable() : enable());
      } catch {
        render(button.getAttribute('aria-pressed') === 'true', 'Nie udało się. Spróbuj jeszcze raz za chwilę.');
      } finally {
        delete button.dataset.busy;
      }
    });

    existing().then((sub) => {
      if (sub && Notification.permission === 'granted') render(true);
      else render(false);
    });
  })();
</script>
