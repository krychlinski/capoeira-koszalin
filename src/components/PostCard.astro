---
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/media';
import { photoCount } from '../lib/format';

interface Props {
  href: string;
  title: string;
  meta?: string;
  excerpt?: string;
  /** Zamiast zajawki: pierwsze pozycje wypunktowania z wpisu. */
  points?: string[];
  image?: string;
  /** Zdjęcie leżące już w public/ — omija optymalizator, bo pobiera je integracja. */
  imageUrl?: string;
  /** Ile zdjęć ma wpis — pokazujemy licznik na kaflu przy albumie. */
  imageCount?: number;
  /** Wpis z filmem — kafel dostaje znaczek odtwarzania. */
  video?: boolean;
}
const { href, title, meta, excerpt, points, image, imageUrl, imageCount = 0, video = false } = Astro.props;
const photo = resolveImage(image);
---

<a class="card" href={href}>
  {(photo || imageUrl) && (
    <div class="card__photo">
      {photo ? (
        <Image src={photo} alt="" widths={[400, 800]} sizes="(max-width: 700px) 100vw, 380px" loading="lazy" />
      ) : (
        <img src={imageUrl} alt="" loading="lazy" decoding="async" />
      )}
      {video && <span class="card__play" aria-hidden="true"></span>}
      {imageCount > 1 && <span class="card__counter">{photoCount(imageCount)}</span>}
    </div>
  )}
  <div class="card__content">
    {meta && <p class="card__meta">{meta}</p>}
    <h3 class="card__title">{title}</h3>
    {points && points.length > 0 ? (
      <ul class="card__points">{points.map((x) => <li>{x}</li>)}</ul>
    ) : (
      excerpt && <p class="card__excerpt">{excerpt}</p>
    )}
    <span class="card__more">Czytaj dalej</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--bg-2);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .card:hover { border-color: var(--accent-dark); transform: translateY(-4px); }

  .card__photo { aspect-ratio: 3 / 2; overflow: hidden; background: var(--bg-3); position: relative; }
  .card__counter {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    background: rgba(11, 11, 12, 0.82);
    color: var(--text);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.3rem 0.6rem;
  }
  /* Trójkąt odtwarzania z obramowań — kafel nie musi wciągać ikony z pliku. */
  .card__play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: rgba(11, 11, 12, 0.7);
    border: 1px solid var(--accent);
    transition: background 0.25s ease;
  }
  .card__play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    /* Trójkąt jest optycznie cięższy z prawej — przesunięcie wyrównuje go w kole. */
    transform: translateX(2px);
    border-left: 0.9rem solid var(--accent);
    border-block: 0.55rem solid transparent;
  }
  .card:hover .card__play { background: rgba(11, 11, 12, 0.45); }

  .card__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.35);
    transition: transform 0.5s ease, filter 0.35s ease;
  }
  .card:hover .card__photo :global(img) { transform: scale(1.05); filter: grayscale(0); }

  .card__placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(70% 70% at 30% 30%, rgba(var(--accent-rgb), 0.16), transparent 70%),
      var(--bg-3);
  }

  .card__content { padding: 1.5rem; display: flex; flex-direction: column; flex: 1; }

  .card__meta {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.6rem;
  }
  .card__title { font-size: 1.3rem; margin: 0 0 0.7rem; }
  .card__excerpt { color: var(--text-2); font-size: 0.9375rem; margin: 0 0 1.25rem; }
  .card__points {
    list-style: none;
    color: var(--text-2);
    font-size: 0.9375rem;
    margin: 0 0 1.25rem;
    padding: 0;
  }
  .card__points li {
    position: relative;
    padding-left: 0.95rem;
    margin-bottom: 0.35rem;
  }
  .card__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    background: var(--accent);
  }
  .card__more {
    margin-top: auto;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-3);
  }
  .card:hover .card__more { color: var(--accent); }
</style>
