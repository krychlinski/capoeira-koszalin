---
import { Image } from 'astro:assets';
import settings from '../data/settings.json';
import { resolveImage } from '../lib/media';

const background = resolveImage(settings.heroImage);
const video = settings.heroYoutubeVideo?.trim();
---

<section class="hero">
  <div class="hero__background">
    {video ? (
      <iframe
        class="hero__video"
        src={`https://www.youtube.com/embed/${video}?autoplay=1&mute=1&loop=1&playlist=${video}&controls=0&showinfo=0&modestbranding=1&playsinline=1&rel=0`}
        title="Capoeira"
        allow="autoplay; encrypted-media"
        loading="lazy"
        tabindex="-1"
      />
    ) : background ? (
      <Image src={background} alt="" widths={[900, 1400, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    ) : null}
  </div>

  <div class="hero__scrim"></div>

  <div class="container hero__content">
    <p class="hero__group">
      <img src="/unicar.svg" alt="" class="hero__seal" width="150" height="150" loading="eager" />
      <span>{settings.group}</span>
    </p>
    <h1 class="hero__title">
      <span>Akademia</span>
      <span class="hero__title--accent">Capoeira</span>
      <span class="hero__city">Koszalin</span>
    </h1>
    <p class="hero__tagline">{settings.heroTagline}</p>
    <div class="hero__actions">
      <a href="#kiedy-trenujemy" class="button">Przyjdź na trening</a>
      <a href="#czym-jest-capoeira" class="button button--outline">Czym jest capoeira</a>
    </div>
  </div>

  <a class="hero__arrow" href="#dalej" aria-label="Przewiń w dół"><span></span></a>
</section>
<span id="dalej"></span>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(3rem, 8vh, 8rem);
    padding-top: clamp(5.5rem, 12vh, 8rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(160deg, #1a1512, #0b0b0c 60%);
  }
  .hero__background :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.45) contrast(1.08);
  }
  /* Wideo z YouTube nie ma object-fit — skalujemy je ponad krawędzie, żeby wypełniło kadr. */
  .hero__video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 56.25vw;
    min-height: 100%;
    min-width: 177.77vh;
    transform: translate(-50%, -50%);
    border: 0;
    pointer-events: none;
    filter: grayscale(0.4) contrast(1.05);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(11, 11, 12, 0.97) 8%, rgba(11, 11, 12, 0.55) 45%, rgba(11, 11, 12, 0.75) 100%),
      radial-gradient(90% 60% at 20% 90%, rgba(var(--accent-rgb), 0.18), transparent 70%);
  }

  .hero__content { position: relative; }

  .hero__group {
    /* Pieczęć obok napisu, nie nad nim. Tekst zawija się we własnej kolumnie,
       a mark zostaje przy nim wyśrodkowany w pionie — także gdy tekst ma
       dwa wiersze na wąskim ekranie. */
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.6vw, 1.5rem);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.1vw, 1.75rem);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1rem;
  }
  /* Pieczęć ma drobny tekst po obwodzie i poniżej mniej więcej 45 px robi się
     nieczytelną plamką — dlatego jest wyraźnie wyższa niż wiersz podpisu. */
  .hero__seal {
    width: clamp(96px, min(11vw, 15vh), 150px);
    height: auto;
    flex: none;
  }

  .hero__title {
    display: grid;
    font-size: clamp(3rem, 11vw, 8.5rem);
    line-height: 0.86;
    margin: 0 0 1.5rem;
  }
  .hero__title span { display: block; }
  .hero__title--accent { color: var(--accent); }
  .hero__city {
    font-size: clamp(0.9rem, 2.2vw, 1.6rem);
    font-weight: 400;
    letter-spacing: 0.52em;
    color: var(--text-2);
    margin-top: 1.1rem;
  }

  .hero__tagline {
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    color: var(--text-2);
    margin-bottom: 2rem;
  }

  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .hero__arrow {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 3rem;
    background: var(--line);
    overflow: hidden;
  }
  .hero__arrow span {
    position: absolute;
    inset: 0;
    background: var(--accent);
    animation: spadaj 2.2s ease-in-out infinite;
  }
  @keyframes spadaj {
    0% { transform: translateY(-100%); }
    60%, 100% { transform: translateY(100%); }
  }
  @media (max-width: 700px) { .hero__arrow { display: none; } }
</style>
