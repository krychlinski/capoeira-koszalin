---
import { Image } from 'astro:assets';
import mapImage from '../assets/map.png';
import settings from '../data/settings.json';

// Obrazek buduje scripts/render-map.py — jest wykadrowany dokładnie na
// współrzędnych Akademii, dlatego pinezka siada na sztywno w środku kadru.
// Po zmianie adresu trzeba uruchomić skrypt od nowa, samo podmienienie
// odnośnika przesunie tylko cel kliknięcia, nie kadr.
const { address, mapUrl } = settings;
const label = address ? `Otwórz w Mapach Google: ${address.replace(/\n/g, ', ')}` : 'Otwórz w Mapach Google';
---

{mapUrl && (
  <figure class="map">
    <a class="map__link" href={mapUrl} target="_blank" rel="noopener noreferrer" aria-label={label}>
      <Image
        src={mapImage}
        alt=""
        widths={[1400]}
        sizes="1400px"
        loading="lazy"
        class="map__image"
      />

      <span class="map__point" aria-hidden="true">
        <svg class="map__pin" viewBox="0 0 24 32" width="24" height="32">
          <path d="M12 0C5.373 0 0 5.373 0 12c0 9 12 20 12 20s12-11 12-20c0-6.627-5.373-12-12-12z" />
          <circle cx="12" cy="12" r="4.5" />
        </svg>
      </span>

      <span class="map__cue">Otwórz w Mapach Google</span>
    </a>

    <figcaption class="map__caption">
      Mapa: <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">© OpenStreetMap</a>
    </figcaption>
  </figure>
)}

<style>
  .map { margin: 0; }

  .map__link {
    display: block;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    line-height: 0;
  }

  .map :global(.map__image) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    /* „none", a nie „cover": mapa ma być KADROWANA do szerokości kontenera,
       nie ściskana. Rozciąganie obrazka w dół skali zmniejsza razem z nim napisy
       narysowane w kafelkach — na telefonie schodziły do 5 px i znikały. Tak
       piksel obrazka odpowiada pikselowi CSS, więc nazwy ulic mają wszędzie tę
       samą wielkość, a wąski ekran po prostu pokazuje mniejszy wycinek okolicy.
       Dlatego obrazek ma też JEDEN rozmiar — wariant z srcset zmieniłby skalę. */
    object-fit: none;
    object-position: center;
    transition: transform 0.6s ease;
  }
  @media (max-width: 640px) {
    .map :global(.map__image) { aspect-ratio: 3 / 4; }
  }

  /* Punkt zakotwiczony w środku kadru — tam leży adres, na którym wykadrowano
     obrazek. Czubek pinezki musi trafić w ten punkt, stąd translate(-50%, -100%). */
  .map__point {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
  }
  .map__pin {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -100%);
    filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.6));
    /* Ścieżka pinezki zajmuje dokładnie cały viewBox, więc obrys wychodzi poza
       niego i SVG obcina go domyślnie — obwódka robi się urwana od góry i boków.
       Czubek musi zostać w rogu kadru, żeby translate(-50%, -100%) trafiał
       w punkt, więc viewBoxa nie da się poszerzyć: zdejmujemy przycinanie. */
    overflow: visible;
  }
  /* Kolory idą przez CSS, a nie przez atrybut fill: var() w atrybucie
     prezentacyjnym SVG nie działa w każdej przeglądarce. */
  .map__pin path {
    fill: var(--accent);
    /* Mapa jest kolorowa i ma zielone plamy parków — bez ciemnej obwódki
       pinezka wtapia się w nie. paint-order odsuwa obrys pod wypełnienie,
       żeby nie zjadał kształtu. */
    stroke: var(--bg);
    stroke-width: 2;
    paint-order: stroke fill;
  }
  .map__pin circle { fill: var(--bg); }

  .map__cue {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.7rem 1.1rem;
    background: var(--bg-2);
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--accent);
  }

  .map__link:hover :global(.map__image) { transform: scale(1.03); }
  .map__link:hover .map__cue { color: var(--accent-light); }

  @media (prefers-reduced-motion: reduce) {
    .map :global(.map__image) { transition: none; }
    .map__link:hover :global(.map__image) { transform: none; }
  }

  .map__caption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-3);
  }
  .map__caption a { color: inherit; }
  .map__caption a:hover { color: var(--text-2); }
</style>
