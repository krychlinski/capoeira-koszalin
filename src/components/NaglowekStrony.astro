---
interface Props {
  nadtytul?: string;
  tytul: string;
  opis?: string;
}
const { nadtytul, tytul, opis } = Astro.props;
---

<section class="naglowek">
  <div class="kontener">
    {nadtytul && <p class="nadtytul">{nadtytul}</p>}
    <h1>{tytul}</h1>
    {opis && <p class="naglowek__opis">{opis}</p>}
  </div>
</section>

<style>
  .naglowek {
    padding-top: clamp(9rem, 16vw, 12rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--linia);
    background:
      radial-gradient(120% 80% at 15% 0%, rgba(var(--akcent-rgb), 0.13), transparent 60%),
      var(--tlo);
  }
  .naglowek__opis {
    /* 58ch łamało krótkie wprowadzenia o kilkadziesiąt pikseli, zostawiając
       pustą połowę kontenera. 68 znaków mieści się w czytelnym zakresie 45-75,
       a dłuższe teksty i tak zawijają się na sensownej szerokości. */
    max-width: 68ch;
    color: var(--tekst-2);
    font-size: 1.125rem;
    margin: 0;
    text-wrap: pretty;
  }
</style>
