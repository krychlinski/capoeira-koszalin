---
import ustawienia from '../data/ustawienia.json';

const rok = new Date().getFullYear();
const social = [
  { href: ustawienia.facebook, tekst: 'Facebook' },
  { href: ustawienia.instagram, tekst: 'Instagram' },
  { href: ustawienia.youtube, tekst: 'YouTube' },
].filter((s) => s.href);
const telHref = ustawienia.telefon ? `tel:+48${ustawienia.telefon.replace(/\s/g, '')}` : null;
---

<footer class="stopka">
  <div class="kontener stopka__wnetrze">
    <div class="stopka__marka">
      <p class="stopka__nazwa">{ustawienia.nazwa}</p>
      {ustawienia.grupa && <p class="stopka__grupa">{ustawienia.grupa}</p>}
    </div>

    <div class="stopka__kolumna">
      <h4 class="stopka__tytul">Kontakt</h4>
      {telHref && <a href={telHref} class="stopka__link">{ustawienia.telefon}</a>}
      {ustawienia.email && <a href={`mailto:${ustawienia.email}`} class="stopka__link">{ustawienia.email}</a>}
      {ustawienia.adres && <p class="stopka__tekst">{ustawienia.adres}</p>}
    </div>

    {social.length > 0 && (
      <div class="stopka__kolumna">
        <h4 class="stopka__tytul">Znajdź nas</h4>
        {social.map((s) => (
          <a href={s.href} class="stopka__link" target="_blank" rel="noopener noreferrer">{s.tekst}</a>
        ))}
      </div>
    )}

    <div class="stopka__kolumna">
      <h4 class="stopka__tytul">Strona</h4>
      <a href="/zajecia/" class="stopka__link">Grafik zajęć</a>
      <a href="/cennik/" class="stopka__link">Cennik</a>
      <a href="/faq/" class="stopka__link">Częste pytania</a>
      <a href="/o-nas/" class="stopka__link">O nas</a>
      <a href="/regulamin/" class="stopka__link">Regulamin</a>
    </div>
  </div>

  <div class="kontener stopka__dol">
    <p>© {rok} {ustawienia.nazwa}</p>
    <p class="stopka__axe">Axé!</p>
  </div>
</footer>

<style>
  .stopka {
    border-top: 1px solid var(--linia);
    background: var(--tlo-2);
    padding-top: clamp(3rem, 6vw, 5rem);
  }
  .stopka__wnetrze {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  @media (max-width: 820px) {
    .stopka__wnetrze { grid-template-columns: 1fr 1fr; }
    .stopka__marka { grid-column: 1 / -1; }
  }

  .stopka__nazwa {
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1.05;
    margin: 0 0 0.35rem;
    max-width: 12ch;
  }
  .stopka__grupa {
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--akcent);
    margin: 0;
  }

  .stopka__tytul {
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    color: var(--tekst-3);
    margin-bottom: 1rem;
  }
  .stopka__link,
  .stopka__tekst {
    display: block;
    color: var(--tekst-2);
    text-decoration: none;
    margin-bottom: 0.55rem;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }
  .stopka__link:hover { color: var(--akcent); }

  .stopka__dol {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--linia);
    padding-block: 1.5rem;
    font-size: 0.8125rem;
    color: var(--tekst-3);
  }
  .stopka__dol p { margin: 0; }
  .stopka__axe {
    font-family: var(--font-display);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--akcent-scisz);
  }
</style>
