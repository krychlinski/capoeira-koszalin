---
import ustawienia from '../data/ustawienia.json';

// Zasłona: dopóki nikt nie kliknie, nic z serwerów Meta się nie ładuje — więc
// żadne ciasteczko nie leci i strona nie potrzebuje baneru zgody.
const profil = ustawienia.facebook?.trim();
const wtyczka = profil
  ? `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(profil)}` +
    '&tabs=timeline&width=500&height=900&small_header=true&adapt_container_width=true' +
    '&hide_cover=false&show_facepile=false'
  : null;
---

{wtyczka && (
  <section class="fb" data-fb data-wtyczka={wtyczka}>
    <div class="fb__zaslona" data-zaslona>
      <svg class="fb__ikona" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07z"
        />
      </svg>
      <h3 class="fb__tytul">Jesteśmy na Facebooku</h3>
      <p class="fb__opis">
        Zdjęcia z treningów, rod i wydarzeń trafiają najpierw tam. Możesz obejrzeć nasze wpisy
        bez wychodzenia ze strony.
      </p>
      <button class="przycisk" data-pokaz>Pokaż wpisy z Facebooka</button>
      <p class="fb__nota">
        Kliknięcie ładuje wtyczkę Facebooka. Meta ustawi wtedy swoje ciasteczka —
        <a href="/prywatnosc/">co to znaczy</a>. Bez kliknięcia nic się nie wczytuje.
      </p>
      <p class="fb__alternatywa">
        Wolisz nie ładować? <a href={profil} target="_blank" rel="noopener noreferrer">Otwórz nasz profil na Facebooku</a>.
      </p>
    </div>
  </section>
)}

<style>
  .fb {
    border: 1px solid var(--linia);
    background: var(--tlo-2);
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }
  .fb__zaslona { max-width: 46ch; }

  .fb__ikona { width: 34px; height: 34px; color: var(--akcent); margin-bottom: 1rem; }
  .fb__tytul { font-size: clamp(1.25rem, 2.5vw, 1.75rem); margin-bottom: 0.75rem; }
  .fb__opis { color: var(--tekst-2); margin-bottom: 1.5rem; }

  .fb__nota,
  .fb__alternatywa {
    font-size: 0.8125rem;
    color: var(--tekst-3);
    margin: 1.25rem 0 0;
  }
  .fb__alternatywa { margin-top: 0.5rem; }
  .fb__nota a,
  .fb__alternatywa a { color: var(--akcent-scisz); }

  /* Wtyczka Meta nie ma trybu ciemnego (colorscheme=dark jest ignorowany), a jej
     wnętrze jest na innej domenie, więc nie da się go ostylować. Zamiast walczyć
     z bielą — oprawiamy ją w ciemną ramkę, żeby czytała się jako świadomy kadr,
     a nie wyrwany kawałek cudzej strony. Inwersja odpada: wywróciłaby zdjęcia
     w negatyw. */
  .fb :global(.fb__ramka) {
    background: var(--tlo-3);
    border: 1px solid var(--linia);
    padding: 0.75rem;
    max-width: 528px;
  }
  .fb :global(iframe) {
    width: 100%;
    height: 900px;
    border: 0;
    display: block;
    filter: brightness(0.94) saturate(0.96);
  }
</style>

<script>
  document.querySelector('[data-pokaz]')?.addEventListener('click', (e) => {
    const sekcja = (e.target as HTMLElement).closest('[data-fb]');
    const zaslona = sekcja?.querySelector('[data-zaslona]');
    const adres = sekcja?.getAttribute('data-wtyczka');
    if (!sekcja || !zaslona || !adres) return;

    const oprawa = document.createElement('div');
    oprawa.className = 'fb__ramka';

    const ramka = document.createElement('iframe');
    ramka.src = adres;
    ramka.title = 'Wpisy z Facebooka';
    ramka.loading = 'lazy';
    ramka.setAttribute('allow', 'encrypted-media');

    oprawa.appendChild(ramka);
    zaslona.replaceWith(oprawa);
  });
</script>
