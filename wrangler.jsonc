{
  // Projekt Cloudflare Pages. Strona jest w całości statyczna, więc jedyne, co
  // trzeba tu podać, to katalog z plikami po zbudowaniu.
  //
  // Wcześniej był tu Worker ze statycznymi zasobami. Nie przyjmował jednak domeny
  // z obcego DNS-u, a `capoeira.koszalin.pl` jest strefą prowadzoną w 42.pl.
  // Pages przyjmuje poddomenę wskazaną CNAME-em i tak działa `www`.
  "name": "capoeira-koszalin",
  "pages_build_output_dir": "./dist"
}
